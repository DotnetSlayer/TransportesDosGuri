@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager NavigationManager

<div class="min-h-screen bg-[#070a13] text-slate-200">
    <div class="flex min-h-screen">

        <NavMenu />

        <main class="flex-1 min-w-0 flex flex-col">

            <header class="h-14 shrink-0 border-b border-slate-800/60 flex items-center justify-between px-6">
                <span class="text-sm text-slate-400 capitalize">@currentRoute</span>
                <span class="text-xs font-mono text-slate-500 tabular-nums">@currentTime BRT</span>
            </header>

            <div class="flex-1 px-6 py-8">
                <div class="max-w-[1400px] mx-auto">
                    @Body
                </div>
            </div>

            <footer class="px-6 pb-6 text-[11px] text-slate-600 text-center">
                Transportes Dos Guri · @DateTime.Now.Year
            </footer>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="hidden fixed bottom-4 right-4 z-50 max-w-sm rounded-lg bg-red-950/90 border border-red-500/40 p-4 text-sm text-red-100">
    <p class="font-semibold">Algo deu errado.</p>
    <a href="." class="reload link text-red-200 mt-2 inline-block">Recarregar</a>
    <button type="button" class="dismiss link text-red-300 ml-3">Fechar</button>
</div>

@code {
    private string currentTime = DateTime.Now.ToString("HH:mm");
    private string currentRoute = "Console";
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        UpdateRoute();
        NavigationManager.LocationChanged += OnLocationChanged;
        timer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now.ToString("HH:mm");
            InvokeAsync(StateHasChanged);
        }, null, 0, 10000);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateRoute();
        StateHasChanged();
    }

    private void UpdateRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        currentRoute = string.IsNullOrWhiteSpace(relativePath) ? "Console" : relativePath.Split('/')[0];
    }

    public void Dispose()
    {
        timer?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}