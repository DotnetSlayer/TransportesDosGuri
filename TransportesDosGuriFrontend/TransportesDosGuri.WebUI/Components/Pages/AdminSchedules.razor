@page "/adminSchedules"
@rendermode InteractiveServer

@inject IScheduleService ScheduleService
@inject IFlightService FlightService
@inject IAirportService AirportService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<PageTitle>Transportes Dos Guri · Horários e Escalas</PageTitle>

<div class="schedules-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="schedules-main">

        <div class="schedules-container">

            <!-- HEADER -->
            <header class="page-header">

                <div class="header-text">
                    <div class="eyebrow">
                        <span class="eyebrow-dot"></span>
                        Operações · Escalas
                    </div>
                    <h1>
                        Horários e
                        <span>escalas.</span>
                    </h1>
                    <p>
                        Defina as janelas de partida e chegada dos voos em cada aeroporto da malha.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(schedules?.Count ?? 0)</span>
                    <span class="counter-label">Escalas</span>
                </div>

            </header>

            <!-- FORM CARD -->
            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(scheduleForm.Id == 0 ? "01" : "02")</span>
                        @(scheduleForm.Id == 0 ? "Nova escala" : "Editando escala")
                    </div>
                </div>

                <EditForm Model="scheduleForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <!-- SECTION: VÍNCULOS -->
                    <div class="subsection">
                        <div class="subsection-label">Vínculos</div>

                        <div class="form-grid form-grid-2">

                            <div class="field">
                                <label>Voo</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                                  stroke="currentColor"
                                                  stroke-width="1.8"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputSelect class="input" @bind-Value="scheduleForm.FlightId">
                                        <option value="0">Selecione o voo...</option>
                                        @foreach (var flight in flightList)
                                        {
                                            <option value="@flight.Id">Voo #@flight.Id</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="field">
                                <label>Aeroporto</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputSelect class="input" @bind-Value="scheduleForm.AirportId">
                                        <option value="0">Selecione o aeroporto...</option>
                                        @foreach (var airport in airportList)
                                        {
                                            <option value="@airport.Id">@airport.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- SECTION: JANELA DE TEMPO -->
                    <div class="subsection">
                        <div class="subsection-label">Janela de tempo</div>

                        <div class="form-grid form-grid-timeline">

                            <div class="field">
                                <label>Partida</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <circle cx="12" cy="12" r="9"
                                                    stroke="currentColor"
                                                    stroke-width="1.7" />
                                            <path d="M12 7v5l3 2"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputDate Type="InputDateType.DateTimeLocal"
                                               class="input input-mono"
                                               @bind-Value="scheduleForm.DepartureTime" />
                                </div>
                            </div>

                            <div class="timeline-arrow">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                                @if (scheduleForm.DepartureTime != default && scheduleForm.ArrivalTime > scheduleForm.DepartureTime)
                                {
                                    <span class="timeline-duration">
                                        @FormatDuration(scheduleForm.ArrivalTime - scheduleForm.DepartureTime)
                                    </span>
                                }
                            </div>

                            <div class="field">
                                <label>Chegada</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <circle cx="12" cy="12" r="9"
                                                    stroke="currentColor"
                                                    stroke-width="1.7" />
                                            <path d="M12 7v5l3 2"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputDate Type="InputDateType.DateTimeLocal"
                                               class="input input-mono"
                                               @bind-Value="scheduleForm.ArrivalTime" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="form-actions">
                        @if (scheduleForm.Id != 0)
                        {
                            <button type="button" @onclick="ResetForm" class="btn-secondary">
                                Cancelar
                            </button>
                        }

                        <button type="submit" class="btn-primary">
                            <span>@(scheduleForm.Id == 0 ? "Criar escala" : "Atualizar escala")</span>
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M5 12h14M13 6l6 6-6 6"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                </EditForm>

            </section>

            <!-- TABLE CARD -->
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Escalas cadastradas
                    </div>
                </div>

                @if (schedules == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando escalas...</span>
                    </div>
                }
                else if (!schedules.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="9"
                                    stroke="currentColor"
                                    stroke-width="1.6" />
                            <path d="M12 7v5l3 2"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhuma escala registrada.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th class="col-flight">Voo</th>
                                    <th>Aeroporto</th>
                                    <th>Partida</th>
                                    <th>Chegada</th>
                                    <th class="col-duration">Duração</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in schedules)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@item.Id</span>
                                        </td>

                                        <td class="col-flight">
                                            <span class="flight-chip">#@item.FlightId</span>
                                        </td>

                                        <td>
                                            <div class="airport-cell">
                                                <span class="airport-icon">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                </span>
                                                <span class="airport-name">@GetAirportName(item.AirportId)</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="datetime-value">@item.DepartureTime.ToString("g")</span>
                                        </td>

                                        <td>
                                            <span class="datetime-value">@item.ArrivalTime.ToString("g")</span>
                                        </td>

                                        <td class="col-duration">
                                            <span class="duration-badge">
                                                <svg viewBox="0 0 24 24" fill="none">
                                                    <circle cx="12" cy="12" r="9"
                                                            stroke="currentColor"
                                                            stroke-width="1.7" />
                                                    <path d="M12 7v5l3 2"
                                                          stroke="currentColor"
                                                          stroke-width="1.7"
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round" />
                                                </svg>
                                                @FormatDuration(item.ArrivalTime - item.DepartureTime)
                                            </span>
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */
    .schedules-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* =========================================================
           BACKGROUND
        ========================================================= */
    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    /* =========================================================
           LAYOUT
        ========================================================= */
    .schedules-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .schedules-container {
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* =========================================================
           HEADER
        ========================================================= */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    /* =========================================================
           FORM CARD
        ========================================================= */
    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        top: -190px;
        right: -190px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    /* =========================================================
           SUBSECTIONS
        ========================================================= */
    .subsection {
        position: relative;
        z-index: 1;
        margin-bottom: 22px;
    }

        .subsection:last-of-type {
            margin-bottom: 0;
        }

    .subsection-label {
        display: inline-block;
        margin-bottom: 12px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #475569;
    }

    /* =========================================================
           FORM GRID
        ========================================================= */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    @@media (min-width: 640px) {
        .form-grid-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 768px) {
        .form-grid-timeline {
            grid-template-columns: 1fr auto 1fr;
            align-items: end;
            gap: 16px;
        }
    }

    /* timeline arrow */
    .timeline-arrow {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 80px;
        height: 48px;
        color: #a78bfa;
        border-radius: 13px;
        background: rgba(139,92,246,.08);
        border: 1px solid rgba(139,92,246,.18);
        box-shadow: inset 0 1px rgba(255,255,255,.05);
        padding: 0 12px;
        position: relative;
    }

        .timeline-arrow > svg {
            width: 18px;
            height: 18px;
        }

    .timeline-duration {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .04em;
        color: #c4b5fd;
        white-space: nowrap;
    }

    @@media (min-width: 768px) {
        .timeline-arrow {
            display: flex;
            height: auto;
            align-self: end;
            padding: 10px 14px;
        }
    }

    /* =========================================================
           FIELD
        ========================================================= */
    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
        appearance: none;
    }

    .input-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12.5px;
    }

    .input::placeholder {
        color: #475569;
    }

    .input:hover {
        border-color: rgba(148,163,184,.16);
    }

    .input:focus {
        border-color: rgba(168,85,247,.55);
        background: rgba(15,23,42,.86);
        box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
    }

    select.input {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 16px;
        padding-right: 42px;
    }

        select.input option {
            background: #0f172a;
            color: #e2e8f0;
        }

    input[type="datetime-local"].input::-webkit-calendar-picker-indicator {
        filter: invert(.6);
        cursor: pointer;
    }

    /* =========================================================
           FORM ACTIONS
        ========================================================= */
    .form-actions {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 24px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient(110deg, #4f46e5, #9333ea 55%, #f59e0b);
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary svg {
            width: 15px;
            height: 15px;
            transition: transform .25s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .btn-primary:hover svg {
                transform: translateX(4px);
            }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 18px;
