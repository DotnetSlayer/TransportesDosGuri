@page "/adminSchedules"
@rendermode InteractiveServer

@inject IScheduleService ScheduleService
@inject IFlightService FlightService
@inject IAirportService AirportService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-6xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Horários e Escalas</h1>

    <EditForm Model="scheduleForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <InputSelect class="input" @bind-Value="scheduleForm.FlightId">
                <option value="0">Voo...</option>
                @foreach (var flight in flightList)
                {
                    <option value="@flight.Id">Voo #@flight.Id</option>
                }
            </InputSelect>

            <InputSelect class="input" @bind-Value="scheduleForm.AirportId">
                <option value="0">Aeroporto...</option>
                @foreach (var airport in airportList)
                {
                    <option value="@airport.Id">@airport.Name</option>
                }
            </InputSelect>

            <InputDate Type="InputDateType.DateTimeLocal" class="input" @bind-Value="scheduleForm.DepartureTime" />
            <InputDate Type="InputDateType.DateTimeLocal" class="input" @bind-Value="scheduleForm.ArrivalTime" />
        </div>

        <div class="flex justify-end gap-2 mt-3">
            @if (scheduleForm.Id != 0)
            {
                <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
            }
            <button type="submit" class="btn-primary">Salvar</button>
        </div>
    </EditForm>

    @if (schedules == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!schedules.Any())
    {
        <p class="text-slate-500 text-sm">Nenhum horário registrado.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">ID</th>
                    <th class="py-2 pr-4">Voo</th>
                    <th class="py-2 pr-4">Aeroporto</th>
                    <th class="py-2 pr-4">Partida</th>
                    <th class="py-2 pr-4">Chegada</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in schedules)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4 text-slate-500">@item.Id</td>
                        <td class="py-2 pr-4 text-slate-400">#@item.FlightId</td>
                        <td class="py-2 pr-4">@GetAirportName(item.AirportId)</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">@item.DepartureTime.ToString("g")</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">@item.ArrivalTime.ToString("g")</td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<ScheduleDTO>? schedules;
    private List<FlightDTO> flightList = new();
    private List<AirportDTO> airportList = new();
    private ScheduleDTO scheduleForm = new() { DepartureTime = DateTime.Now, ArrivalTime = DateTime.Now.AddHours(2) };

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadSchedules();
    }

    private async Task LoadDropdowns()
    {
        flightList = await FlightService.GetAllAsync() ?? new();
        airportList = await AirportService.GetAllAsync() ?? new();
    }

    private async Task LoadSchedules() => schedules = await ScheduleService.GetAllAsync();

    private async Task Save()
    {
        if (scheduleForm.Id == 0)
            await ScheduleService.CreateAsync(scheduleForm);
        else
            await ScheduleService.UpdateAsync(scheduleForm.Id, scheduleForm);

        ResetForm();
        await LoadSchedules();
    }

    private void Edit(ScheduleDTO item)
    {
        scheduleForm = new ScheduleDTO
        {
            Id = item.Id,
            FlightId = item.FlightId,
            AirportId = item.AirportId,
            DepartureTime = item.DepartureTime,
            ArrivalTime = item.ArrivalTime
        };
    }

    private async Task Delete(long id)
    {
        await ScheduleService.DeleteAsync(id);
        await LoadSchedules();
    }

    private void ResetForm() => scheduleForm = new ScheduleDTO { DepartureTime = DateTime.Now, ArrivalTime = DateTime.Now.AddHours(2) };

    private string GetAirportName(long id) =>
        airportList.FirstOrDefault(a => a.Id == id)?.Name ?? id.ToString();
}