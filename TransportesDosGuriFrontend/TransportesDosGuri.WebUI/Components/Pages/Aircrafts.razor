@page "/aircrafts"
@rendermode InteractiveServer

@inject IAircraftService AircraftService
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<h3>Gestão de Aeronaves</h3>

<!-- Form de Cadastro / Edição -->
<div class="card mb-4">
    <div class="card-header">@(aircraftForm.Id == 0 ? "Nova Aeronave" : "Editar Aeronave")</div>
    <div class="card-body">
        <EditForm Model="aircraftForm" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Modelo</label>
                    <InputText class="form-control" @bind-Value="aircraftForm.Model" placeholder="Ex: Boeing 737" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Tipo</label>
                    <InputSelect class="form-select" @bind-Value="aircraftForm.Type">
                        @foreach (var type in Enum.GetValues<AircraftType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">Salvar</button>
                    @if (aircraftForm.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancelar</button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

<!-- Tabela de Listagem -->
@if (aircrafts == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Modelo</th>
                <th>Tipo</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in aircrafts)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Model</td>
                    <td>@item.Type</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => Edit(item)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item.Id)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AircraftDto>? aircrafts;
    private AircraftDto aircraftForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAircrafts();
    }

    private async Task LoadAircrafts()
    {
        aircrafts = await AircraftService.GetAllAsync();
    }

    private async Task Save()
    {
        if (aircraftForm.Id == 0)
            await AircraftService.CreateAsync(aircraftForm);
        else
            await AircraftService.UpdateAsync(aircraftForm.Id, aircraftForm);

        ResetForm();
        await LoadAircrafts();
    }

    private void Edit(AircraftDto item)
    {
        aircraftForm = new AircraftDto { Id = item.Id, Model = item.Model, Type = item.Type };
    }

    private async Task Delete(long id)
    {
        await AircraftService.DeleteAsync(id);
        await LoadAircrafts();
    }

    private void ResetForm()
    {
        aircraftForm = new AircraftDto();
    }
}