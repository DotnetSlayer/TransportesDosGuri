@page "/adminAircrafts"
@rendermode InteractiveServer

@inject IAircraftService AircraftService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-6xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Frota</h1>

    <EditForm Model="aircraftForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <InputText class="input" @bind-Value="aircraftForm.Model" placeholder="Modelo (ex: B737-800)" />

            <InputSelect class="input" @bind-Value="aircraftForm.Type">
                @foreach (var type in Enum.GetValues<AircraftType>())
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>

            <div class="flex gap-2">
                <button type="submit" class="btn-primary flex-1">Salvar</button>
                @if (aircraftForm.Id != 0)
                {
                    <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
                }
            </div>
        </div>
    </EditForm>

    @if (aircrafts == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!aircrafts.Any())
    {
        <p class="text-slate-500 text-sm">Nenhuma aeronave registrada.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">ID</th>
                    <th class="py-2 pr-4">Modelo</th>
                    <th class="py-2 pr-4">Tipo</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in aircrafts)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4 text-slate-500">@item.Id</td>
                        <td class="py-2 pr-4 font-mono">@item.Model</td>
                        <td class="py-2 pr-4 text-slate-400">@item.Type</td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<AircraftDTO>? aircrafts;
    private AircraftDTO aircraftForm = new();

    protected override async Task OnInitializedAsync() => await LoadAircrafts();

    private async Task LoadAircrafts() => aircrafts = await AircraftService.GetAllAsync();

    private async Task Save()
    {
        if (aircraftForm.Id == 0)
            await AircraftService.CreateAsync(aircraftForm);
        else
            await AircraftService.UpdateAsync(aircraftForm.Id, aircraftForm);

        ResetForm();
        await LoadAircrafts();
    }

    private void Edit(AircraftDTO item)
    {
        aircraftForm = new AircraftDTO { Id = item.Id, Model = item.Model, Type = item.Type };
    }

    private async Task Delete(long id)
    {
        await AircraftService.DeleteAsync(id);
        await LoadAircrafts();
    }

    private void ResetForm() => aircraftForm = new AircraftDTO();
}