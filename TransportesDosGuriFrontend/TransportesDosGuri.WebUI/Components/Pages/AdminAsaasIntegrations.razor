@page "/adminAsaasIntegrations"
@rendermode InteractiveServer

@inject IAsaasIntegrationService AsaasIntegrationService
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-5xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Integração Asaas</h1>

    <EditForm Model="asaasIntegrationForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <InputText class="input" @bind-Value="asaasIntegrationForm.Environment" placeholder="Ambiente (Sandbox / Production)" />
            <InputText class="input font-mono" @bind-Value="asaasIntegrationForm.BaseUrl" placeholder="URL Base" />
            <InputText type="password" class="input font-mono" @bind-Value="asaasIntegrationForm.ApiKey" placeholder="Chave da API" />
        </div>
        <div class="flex items-center justify-between mt-3">
            <label class="inline-flex items-center gap-2 text-sm text-slate-400 cursor-pointer">
                <InputCheckbox @bind-Value="asaasIntegrationForm.IsActive" />
                Ambiente ativo
            </label>
            <div class="flex gap-2">
                @if (asaasIntegrationForm.Id != 0)
                {
                    <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
                }
                <button type="submit" class="btn-primary">Salvar</button>
            </div>
        </div>
    </EditForm>

    @if (asaasIntegrations == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!asaasIntegrations.Any())
    {
        <p class="text-slate-500 text-sm">Nenhuma integração configurada.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">Status</th>
                    <th class="py-2 pr-4">Ambiente</th>
                    <th class="py-2 pr-4">URL Base</th>
                    <th class="py-2 pr-4">API Key</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in asaasIntegrations)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4">
                            @if (item.IsActive)
                            {
                                <span class="text-emerald-400">● Ativo</span>
                            }
                            else
                            {
                                <span class="text-slate-500">● Inativo</span>
                            }
                        </td>
                        <td class="py-2 pr-4">@item.Environment</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">@item.BaseUrl</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-500">••••••••••••</td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<AsaasIntegrationDTO>? asaasIntegrations;
    private AsaasIntegrationDTO asaasIntegrationForm = new();

    protected override async Task OnInitializedAsync() => await LoadAsaasIntegrations();
    private async Task LoadAsaasIntegrations() => asaasIntegrations = await AsaasIntegrationService.GetAllAsync();

    private async Task Save()
    {
        if (asaasIntegrationForm.Id == 0) await AsaasIntegrationService.CreateAsync(asaasIntegrationForm);
        else await AsaasIntegrationService.UpdateAsync(asaasIntegrationForm.Id, asaasIntegrationForm);
        ResetForm();
        await LoadAsaasIntegrations();
    }

    private void Edit(AsaasIntegrationDTO item) => asaasIntegrationForm = new AsaasIntegrationDTO
    {
        Id = item.Id,
        Environment = item.Environment,
        ApiKey = item.ApiKey,
        BaseUrl = item.BaseUrl,
        IsActive = item.IsActive
    };

    private async Task Delete(long id)
    {
        await AsaasIntegrationService.DeleteAsync(id);
        await LoadAsaasIntegrations();
    }

    private void ResetForm() => asaasIntegrationForm = new AsaasIntegrationDTO();
}