@code {
    private List<ReservationDTO>? reservations;
    private List<UserDTO> userList = new();
    private List<FlightSeatDTO> seatList = new();
    private List<PurchaseDTO> purchaseList = new();
    private ReservationDTO reservationForm = new() { ReservationDate = DateTime.Now };

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadReservations();
    }

    private async Task LoadDropdowns()
    {
        userList = await UserService.GetAllAsync() ?? new();
        seatList = await FlightSeatService.GetAllAsync() ?? new();
        purchaseList = await PurchaseService.GetAllAsync() ?? new();
    }

    private async Task LoadReservations() => reservations = await ReservationService.GetAllAsync();

    private async Task Save()
    {
        if (reservationForm.Id == 0)
            await ReservationService.CreateAsync(reservationForm);
        else
            await ReservationService.UpdateAsync(reservationForm.Id, reservationForm);

        ResetForm();
        await LoadReservations();
    }

    private void Edit(ReservationDTO item)
    {
        reservationForm = new ReservationDTO
        {
            Id = item.Id,
            ApplicationUserId = item.ApplicationUserId,
            FlightSeatId = item.FlightSeatId,
            PurchaseId = item.PurchaseId,
            ReservationDate = item.ReservationDate,
            Status = item.Status,
            Price = item.Price
        };
    }

    private async Task Delete(long id)
    {
        await ReservationService.DeleteAsync(id);
        await LoadReservations();
    }

    private void ResetForm() => reservationForm = new ReservationDTO { ReservationDate = DateTime.Now };

    private string GetUserDisplay(long id) =>
        userList.FirstOrDefault(u => u.Id == id)?.Name ?? id.ToString();

    private string GetSeatDisplay(long id) =>
        seatList.FirstOrDefault(s => s.Id == id)?.SeatNumber ?? id.ToString();

    private string GetUserInitials(long userId)
    {
        var user = userList.FirstOrDefault(u => u.Id == userId);
        if (user == null || string.IsNullOrWhiteSpace(user.Name))
            return "?";

        var parts = user.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    /* =========================================================
       VARIANT HELPERS
    ========================================================= */
    private string GetStatusVariant(ReservationStatus status) => status.ToString().ToLowerInvariant() switch
    {
        "confirmed" => "status-confirmed",
        "pending" => "status-pending",
        "cancelled" => "status-cancelled",
        "canceled" => "status-canceled",
        _ => "status-default"
    };
}