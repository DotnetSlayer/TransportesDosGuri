@code {

    [Parameter]
    public long TripId { get; set; }

    private TripDetailsDTO? trip;

    private bool loading;

    private bool buying;

    private HashSet<long> selectedSeatIds = new();

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTripAsync();
    }

    private async Task LoadTripAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            trip = await TripService.GetDetailsAsync(TripId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar viagem: {ex}");

            errorMessage = ex.Message;
            trip = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleSeat(long seatId)
    {
        if (selectedSeatIds.Contains(seatId))
        {
            selectedSeatIds.Remove(seatId);
        }
        else
        {
            selectedSeatIds.Add(seatId);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task BuySeatsAsync()
    {
        if (buying)
            return;

        if (selectedSeatIds.Count == 0)
            return;

        buying = true;

        try
        {
            var request = new BuySeatRequestDTO
            {
                TripId = TripId,
                FlightSeatIds = selectedSeatIds.ToList()
            };

            var result = await PurchaseService.BuySeatsAsync(request);

            if (result == null)
                return;

            Navigation.NavigateTo($"/purchase/{result.PurchaseId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao comprar assentos: {ex.Message}");
        }
        finally
        {
            buying = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/trips");
    }

}