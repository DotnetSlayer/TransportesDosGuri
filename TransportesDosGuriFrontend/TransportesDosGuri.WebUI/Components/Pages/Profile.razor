@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Meu Perfil</PageTitle>

<div class="profile-page">

    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="profile-main">
        <div class="profile-container">

            <header class="page-header">
                <div class="header-text">
                    <button class="back-link" @onclick="GoBack">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M19 12H5M11 18l-6-6 6-6"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        Voltar
                    </button>

                    <h1>
                        Meu
                        <span>perfil.</span>
                    </h1>

                    <p>
                        Atualize seus dados cadastrais.
                    </p>
                </div>
            </header>

            @if (loading)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Carregando perfil...</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage) && user == null)
            {
                <div class="state-box empty">
                    <h2>Não foi possível carregar o perfil</h2>
                    <p>@errorMessage</p>

                    <button class="primary-button" @onclick="LoadProfileAsync">
                        Tentar novamente
                    </button>
                </div>
            }
            else if (user == null)
            {
                <div class="state-box empty">
                    <h2>Perfil não encontrado</h2>
                    <p>Não conseguimos carregar seus dados.</p>
                </div>
            }
            else
            {
                <section class="profile-card">
                    <div class="stat-card-glow"></div>

                    <div class="card-header">
                        <div class="avatar-icon">
                            <svg viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" />
                                <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"
                                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="card-title">
                            <span class="trip-id">Usuário</span>
                            <h2>@user.Name @user.LastName</h2>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success">
                            <svg viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                                <path d="M8 12l3 3 5-6"
                                      stroke="currentColor" stroke-width="1.8"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>@successMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-error">
                            <svg viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                                <path d="M12 8v4M12 16h.01"
                                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="form-grid">

                            <div class="form-group">
                                <label>Nome</label>
                                <InputText @bind-Value="editModel.Name" class="form-input" />
                            </div>

                            <div class="form-group">
                                <label>Sobrenome</label>
                                <InputText @bind-Value="editModel.LastName" class="form-input" />
                            </div>

                            <div class="form-group">
                                <label>E-mail (não editável)</label>
                                <input class="form-input" value="@user.Email" disabled />
                            </div>

                            <div class="form-group">
                                <label>Telefone</label>
                                <InputText @bind-Value="editModel.PhoneNumber" class="form-input" />
                            </div>

                            <div class="form-group">
                                <label>CPF</label>
                                <InputText @bind-Value="editModel.IdentityNumber" class="form-input" />
                            </div>

                        </div>

                        <button type="submit"
                                class="primary-button"
                                disabled="@saving">
                            @if (saving)
                            {
                                <span class="button-spinner"></span>
                                <span>Salvando...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12l5 5L20 7"
                                          stroke="currentColor" stroke-width="1.8"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Salvar alterações</span>
                            }
                        </button>
                    </EditForm>

                    <div class="danger-zone">
                        <div class="danger-header">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M12 9v4M12 17h.01"
                                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                            </svg>
                            <span>Zona de perigo</span>
                        </div>

                        <p>
                            Excluir sua conta é uma ação permanente. Todas as suas reservas
                            e compras pendentes serão afetadas.
                        </p>

                        <button class="ghost-button danger-button"
                                @onclick="DeleteAccountAsync"
                                disabled="@deleting">

                            @if (deleting)
                            {
                                <span class="button-spinner"></span>
                                <span>Excluindo...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14"
                                          stroke="currentColor" stroke-width="1.8"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Excluir minha conta</span>
                            }
                        </button>
                    </div>

                </section>
            }

        </div>
    </main>

</div>

<style>
    /* =========================================================
               PAGE
            ========================================================= */
    .profile-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    .profile-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .profile-container {
        flex: 1;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
        padding: 6px 12px 6px 8px;
        border-radius: 999px;
        cursor: pointer;
        color: #a5b4fc;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        transition: all .25s ease;
    }

        .back-link svg {
            width: 14px;
            height: 14px;
        }

        .back-link:hover {
            color: #c7d2fe;
            border-color: rgba(168,85,247,.35);
            background: rgba(79,70,229,.16);
        }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .profile-card {
        position: relative;
        padding: 28px;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .stat-card-glow {
        position: absolute;
        width: 260px;
        height: 260px;
        top: -140px;
        right: -140px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: .55;
        pointer-events: none;
        background: rgba(99,102,241,.55);
    }

    .card-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(255,255,255,.06);
        margin-bottom: 20px;
    }

    .avatar-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #a5b4fc;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(99,102,241,.22);
    }

        .avatar-icon svg {
            width: 22px;
            height: 22px;
        }

    .card-title h2 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.03em;
    }

    .trip-id {
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .form-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 640px) {
        .form-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group label {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: #64748b;
        }

    .form-input {
        height: 46px;
        padding: 0 14px;
        border-radius: 12px;
        color: #ffffff;
        font-size: 13px;
        background: rgba(2,6,23,.42);
        border: 1px solid rgba(255,255,255,.08);
        outline: none;
        transition: border-color .25s ease, box-shadow .25s ease;
    }

        .form-input:focus {
            border-color: rgba(168,85,247,.45);
            box-shadow: 0 0 0 3px rgba(99,102,241,.15);
        }

        .form-input:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .primary-button {
        position: relative;
        z-index: 1;
        margin-top: 24px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 50px;
        padding: 0 22px;
        border-radius: 14px;
        cursor: pointer;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .02em;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: 1px solid rgba(255,255,255,.10);
        box-shadow: 0 14px 32px rgba(99,102,241,.30), inset 0 1px rgba(255,255,255,.12);
        transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }

        .primary-button svg {
            width: 18px;
            height: 18px;
        }

        .primary-button:hover:not(:disabled) {
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 20px 42px rgba(147,51,234,.38), inset 0 1px rgba(255,255,255,.16);
        }

        .primary-button:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .ghost-button {
        position: relative;
        z-index: 1;
        margin-top: 16px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 50px;
        padding: 0 22px;
        border-radius: 14px;
        cursor: pointer;
        color: #cbd5e1;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .02em;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04);
        transition: all .25s ease;
    }

        .ghost-button svg {
            width: 18px;
            height: 18px;
        }

        .ghost-button:hover:not(:disabled) {
            color: #ffffff;
            border-color: rgba(168,85,247,.35);
            background: linear-gradient(135deg, rgba(79,70,229,.20), rgba(147,51,234,.14));
            box-shadow: 0 12px 30px rgba(99,102,241,.22), inset 0 1px rgba(255,255,255,.08);
        }

        .ghost-button:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .button-spinner {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.30);
        border-top-color: #ffffff;
        animation: spin .8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .alert {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

        .alert svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .alert-success {
        color: #6ee7b7;
        background: rgba(16,185,129,.08);
        border: 1px solid rgba(16,185,129,.24);
    }

    .alert-error {
        color: #fca5a5;
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.24);
    }

    .danger-zone {
        position: relative;
        z-index: 1;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .danger-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: #fca5a5;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
    }

        .danger-header svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .danger-zone p {
        margin: 0 0 16px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
    }

    .danger-button {
        color: #fca5a5;
        background: rgba(239,68,68,.06);
        border: 1px solid rgba(239,68,68,.24);
    }

        .danger-button:hover:not(:disabled) {
            color: #ffffff;
            border-color: rgba(239,68,68,.55);
            background: linear-gradient(135deg, rgba(239,68,68,.20), rgba(220,38,38,.14));
            box-shadow: 0 12px 30px rgba(239,68,68,.22), inset 0 1px rgba(255,255,255,.08);
        }

    .state-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 64px 24px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(15,23,42,.62), rgba(2,6,23,.48));
        border: 1px solid rgba(255,255,255,.06);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        text-align: center;
    }

        .state-box p {
            margin: 0;
            color: #64748b;
            font-size: 12.5px;
            word-break: break-word;
            max-width: 640px;
        }

        .state-box h2 {
            margin: 6px 0 0;
            color: #ffffff;
            font-size: 20px;
            font-weight: 800;
        }

    .spinner {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 2px solid rgba(148,163,184,.20);
        border-top-color: #a855f7;
        animation: spin .8s linear infinite;
    }
</style>

@code {

    private UserDTO? user;

    private UpdateUserDTO editModel = new();

    private bool loading;

    private bool saving;

    private bool deleting;

    private string? successMessage;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            user = await UserService.GetMeAsync();

            if (user != null)
            {
                editModel = new UpdateUserDTO
                {
                    Name = user.Name,
                    LastName = user.LastName,
                    PhoneNumber = user.PhoneNumber,
                    IdentityNumber = user.IdentityNumber
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar perfil: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var ok = await UserService.UpdateMeAsync(editModel);

            if (ok)
            {
                successMessage = "Dados atualizados com sucesso!";
                await LoadProfileAsync();
            }
            else
            {
                errorMessage = "Não foi possível atualizar seus dados.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (deleting) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Tem certeza que deseja excluir sua conta? Essa ação é permanente e não pode ser desfeita.");

        if (!confirmed) return;

        deleting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var ok = await UserService.DeleteMeAsync();

            if (!ok)
            {
                errorMessage =
                    "Não foi possível excluir sua conta. " +
                    "Talvez existam compras ou reservas associadas.";
                return;
            }

            await JS.InvokeVoidAsync("localStorage.clear");
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao excluir: {ex.Message}";
        }
        finally
        {
            deleting = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}