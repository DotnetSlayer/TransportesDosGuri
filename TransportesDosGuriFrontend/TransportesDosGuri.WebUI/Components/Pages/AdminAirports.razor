@page "/adminAirports"
@rendermode InteractiveServer

@inject IAirportService AirportService
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-5xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Aeroportos</h1>

    <EditForm Model="airportForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <InputText class="input" @bind-Value="airportForm.Name" placeholder="Nome" />
            <InputText class="input" @bind-Value="airportForm.City" placeholder="Cidade" />
            <InputText class="input" @bind-Value="airportForm.State" placeholder="Estado" />
            <InputText class="input" @bind-Value="airportForm.Country" placeholder="País" />
        </div>
        <div class="flex justify-end gap-2 mt-3">
            @if (airportForm.Id != 0)
            {
                <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
            }
            <button type="submit" class="btn-primary">Salvar</button>
        </div>
    </EditForm>

    @if (airports == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!airports.Any())
    {
        <p class="text-slate-500 text-sm">Nenhum aeroporto cadastrado.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">ID</th>
                    <th class="py-2 pr-4">Nome</th>
                    <th class="py-2 pr-4">Cidade</th>
                    <th class="py-2 pr-4">Estado</th>
                    <th class="py-2 pr-4">País</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in airports)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4 text-slate-500">@item.Id</td>
                        <td class="py-2 pr-4">@item.Name</td>
                        <td class="py-2 pr-4">@item.City</td>
                        <td class="py-2 pr-4">@item.State</td>
                        <td class="py-2 pr-4">@item.Country</td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<AirportDTO>? airports;
    private AirportDTO airportForm = new();

    protected override async Task OnInitializedAsync() => await LoadAirports();
    private async Task LoadAirports() => airports = await AirportService.GetAllAsync();

    private async Task Save()
    {
        if (airportForm.Id == 0) await AirportService.CreateAsync(airportForm);
        else await AirportService.UpdateAsync(airportForm.Id, airportForm);
        ResetForm();
        await LoadAirports();
    }

    private void Edit(AirportDTO item) => airportForm = new AirportDTO
    {
        Id = item.Id,
        Name = item.Name,
        City = item.City,
        State = item.State,
        Country = item.Country
    };

    private async Task Delete(long id)
    {
        await AirportService.DeleteAsync(id);
        await LoadAirports();
    }

    private void ResetForm() => airportForm = new AirportDTO();
}