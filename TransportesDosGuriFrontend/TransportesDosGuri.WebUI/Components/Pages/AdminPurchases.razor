@page "/adminPurchases"
@rendermode InteractiveServer

@inject IPurchaseService PurchaseService
@inject IUserService UserService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-6xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Compras</h1>

    <EditForm Model="purchaseForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <InputSelect class="input" @bind-Value="purchaseForm.ApplicationUserId">
                <option value="0">Usuário...</option>
                @foreach (var user in userList)
                {
                    <option value="@user.Id">@user.Name (@user.Email)</option>
                }
            </InputSelect>

            <InputDate Type="InputDateType.DateTimeLocal" class="input" @bind-Value="purchaseForm.PurchaseDate" />

            <InputNumber class="input" @bind-Value="purchaseForm.PurchasePrice" step="0.01" placeholder="Valor (R$)" />

            <InputSelect class="input" @bind-Value="purchaseForm.Status">
                @foreach (var status in Enum.GetValues<PurchaseStatus>())
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>

        <div class="flex justify-end gap-2 mt-3">
            @if (purchaseForm.Id != 0)
            {
                <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
            }
            <button type="submit" class="btn-primary">Salvar</button>
        </div>
    </EditForm>

    @if (purchases == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!purchases.Any())
    {
        <p class="text-slate-500 text-sm">Nenhuma compra registrada.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">ID</th>
                    <th class="py-2 pr-4">Usuário</th>
                    <th class="py-2 pr-4">Data</th>
                    <th class="py-2 pr-4">Valor</th>
                    <th class="py-2 pr-4">Status</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in purchases)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4 text-slate-500">@item.Id</td>
                        <td class="py-2 pr-4">@GetUserDisplay(item.ApplicationUserId)</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">@item.PurchaseDate.ToString("g")</td>
                        <td class="py-2 pr-4 font-mono text-xs text-emerald-400">@item.PurchasePrice.ToString("C")</td>
                        <td class="py-2 pr-4">@item.Status</td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<PurchaseDTO>? purchases;
    private List<UserDTO> userList = new();
    private PurchaseDTO purchaseForm = new() { PurchaseDate = DateTime.Now };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadPurchases();
    }

    private async Task LoadUsers() => userList = await UserService.GetAllAsync() ?? new();
    private async Task LoadPurchases() => purchases = await PurchaseService.GetAllAsync();

    private async Task Save()
    {
        if (purchaseForm.Id == 0)
            await PurchaseService.CreateAsync(purchaseForm);
        else
            await PurchaseService.UpdateAsync(purchaseForm.Id, purchaseForm);

        ResetForm();
        await LoadPurchases();
    }

    private void Edit(PurchaseDTO item)
    {
        purchaseForm = new PurchaseDTO
        {
            Id = item.Id,
            ApplicationUserId = item.ApplicationUserId,
            PurchaseDate = item.PurchaseDate,
            PurchasePrice = item.PurchasePrice,
            Status = item.Status
        };
    }

    private async Task Delete(long id)
    {
        await PurchaseService.DeleteAsync(id);
        await LoadPurchases();
    }

    private void ResetForm()
    {
        purchaseForm = new PurchaseDTO { PurchaseDate = DateTime.Now };
    }

    private string GetUserDisplay(long userId)
    {
        var user = userList.FirstOrDefault(u => u.Id == userId);
        return user != null ? $"{user.Name}" : userId.ToString();
    }
}