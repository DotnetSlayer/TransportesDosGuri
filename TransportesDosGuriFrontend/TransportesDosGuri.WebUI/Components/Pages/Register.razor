@page "/account/register"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registro - Transportes dos Guri</PageTitle>

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Criar Nova Conta</h3>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <EditForm Model="Model" OnValidSubmit="HandleRegister" FormName="registerForm">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nome *</label>
                            <InputText @bind-Value="Model.Name" class="form-control" placeholder="Nome" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sobrenome *</label>
                            <InputText @bind-Value="Model.LastName" class="form-control" placeholder="Sobrenome" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-mail *</label>
                        <InputText @bind-Value="Model.Email" type="email" class="form-control" placeholder="seu@email.com" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Senha *</label>
                            <InputText @bind-Value="Model.Password" type="password" class="form-control" placeholder="******" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">CPF/CNPJ *</label>
                            <InputText @bind-Value="Model.IdentityNumber" class="form-control" placeholder="Apenas números" />
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h5 class="text-muted mb-3">Endereço</h5>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">CEP</label>
                            <InputText @bind-Value="Model.ZipCode" class="form-control" placeholder="00000-000" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <label class="form-label">Rua / Logradouro</label>
                            <InputText @bind-Value="Model.Address" class="form-control" placeholder="Rua..." />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Número</label>
                            <InputNumber @bind-Value="Model.AddressNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bairro</label>
                            <InputText @bind-Value="Model.District" class="form-control" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <label class="form-label">Cidade</label>
                            <InputText @bind-Value="Model.City" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">UF</label>
                            <InputText @bind-Value="Model.State" class="form-control" maxlength="2" placeholder="EX: SC" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Cadastrando...</span>
                        }
                        else
                        {
                            <span>Cadastrar</span>
                        }
                    </button>

                    <div class="text-center mt-3">
                        <small>Já possui uma conta? <a href="account/login">Faça Login</a></small>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterDTO? registerModel { get; set; }

    private RegisterDTO Model => registerModel ??= new();
    private string? errorMessage;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        registerModel ??= new();
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        isSubmitting = true;

        var success = await AuthService.RegisterAsync(Model);
        
        isSubmitting = false;

        if (success)
        {
            // Redireciona para a página de login após cadastro bem-sucedido
            Navigation.NavigateTo("account/login");
        }
        else
        {
            errorMessage = "Falha ao realizar o cadastro. Verifique os dados fornecidos ou tente novamente mais tarde.";
        }
    }
}