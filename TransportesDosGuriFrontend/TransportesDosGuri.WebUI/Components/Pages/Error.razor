@page "/Error"
@using System.Diagnostics

<PageTitle>Erro - Air Ops</PageTitle>

<div class="max-w-xl mx-auto p-6 space-y-4 text-slate-200">
    <h1 class="text-xl font-semibold text-red-400">Falha no processamento</h1>
    <p class="text-sm text-slate-400">Ocorreu um erro ao processar sua requisição.</p>

    @if (ShowRequestId)
    {
        <p class="text-xs font-mono text-slate-500">
            Request ID: <span class="text-slate-300 select-all">@RequestId</span>
        </p>
    }

    <p class="text-xs text-slate-500 border-l-2 border-amber-500/40 pl-3">
        Em ambiente de desenvolvimento, informações detalhadas sobre a exceção são exibidas.
        Não habilite esse modo em produção.
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}