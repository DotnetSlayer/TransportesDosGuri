@page "/adminUserRequests"
@rendermode InteractiveServer

@inject IUserRequestService UserRequestService
@inject IUserService UserService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<div class="max-w-6xl mx-auto p-6 space-y-8 text-slate-200">

    <h1 class="text-2xl font-semibold">Solicitações</h1>

    <EditForm Model="requestForm" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <InputSelect class="input" @bind-Value="requestForm.ApplicationUserId">
                <option value="0">Usuário...</option>
                @foreach (var user in userList)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </InputSelect>

            <InputNumber class="input" @bind-Value="requestForm.Price" step="0.01" placeholder="Preço (R$)" />

            <InputDate class="input" @bind-Value="requestForm.DueDate" />
        </div>

        <div class="mt-3">
            <InputText class="input" @bind-Value="requestForm.AsaasSubscriptionId" placeholder="ID assinatura Asaas (sub_...)" />
        </div>

        <div class="flex justify-end gap-2 mt-3">
            @if (requestForm.Id != 0)
            {
                <button type="button" @onclick="ResetForm" class="btn-secondary">Cancelar</button>
            }
            <button type="submit" class="btn-primary">Salvar</button>
        </div>
    </EditForm>

    @if (userRequests == null)
    {
        <p class="text-slate-500 text-sm">Carregando...</p>
    }
    else if (!userRequests.Any())
    {
        <p class="text-slate-500 text-sm">Nenhuma solicitação registrada.</p>
    }
    else
    {
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="text-left text-slate-400 border-b border-slate-700">
                    <th class="py-2 pr-4">ID</th>
                    <th class="py-2 pr-4">Usuário</th>
                    <th class="py-2 pr-4">Valor</th>
                    <th class="py-2 pr-4">Vencimento</th>
                    <th class="py-2 pr-4">Assinatura Asaas</th>
                    <th class="py-2 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in userRequests)
                {
                    <tr class="border-b border-slate-800">
                        <td class="py-2 pr-4 text-slate-500">@item.Id</td>
                        <td class="py-2 pr-4">@GetUserDisplay(item.ApplicationUserId)</td>
                        <td class="py-2 pr-4 font-mono text-xs text-emerald-400">@item.Price.ToString("C")</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">@item.DueDate.ToString("dd/MM/yyyy")</td>
                        <td class="py-2 pr-4 font-mono text-xs text-slate-400">
                            @(string.IsNullOrEmpty(item.AsaasSubscriptionId) ? "-" : item.AsaasSubscriptionId)
                        </td>
                        <td class="py-2 text-right space-x-2">
                            <button @onclick="() => Edit(item)" class="link">Editar</button>
                            <button @onclick="() => Delete(item.Id)" class="link-danger">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 0.875rem;
        outline: none;
    }

        .input:focus {
            border-color: #3b82f6;
        }

    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: #2563eb;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }

    .btn-secondary {
        padding: 0.5rem 1rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: #1e293b;
        }

    .link {
        color: #93c5fd;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link:hover {
            text-decoration: underline;
        }

    .link-danger {
        color: #fca5a5;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .link-danger:hover {
            text-decoration: underline;
        }
</style>

@code {
    private List<UserRequestDTO>? userRequests;
    private List<UserDTO> userList = new();
    private UserRequestDTO requestForm = new() { DueDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7)) };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadUserRequests();
    }

    private async Task LoadUsers() => userList = await UserService.GetAllAsync() ?? new();
    private async Task LoadUserRequests() => userRequests = await UserRequestService.GetAllAsync();

    private async Task Save()
    {
        if (requestForm.Id == 0)
            await UserRequestService.CreateAsync(requestForm);
        else
            await UserRequestService.UpdateAsync(requestForm.Id, requestForm);

        ResetForm();
        await LoadUserRequests();
    }

    private void Edit(UserRequestDTO item)
    {
        requestForm = new UserRequestDTO
        {
            Id = item.Id,
            Price = item.Price,
            DueDate = item.DueDate,
            ApplicationUserId = item.ApplicationUserId,
            AsaasSubscriptionId = item.AsaasSubscriptionId
        };
    }

    private async Task Delete(long id)
    {
        await UserRequestService.DeleteAsync(id);
        await LoadUserRequests();
    }

    private void ResetForm() => requestForm = new UserRequestDTO { DueDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7)) };

    private string GetUserDisplay(long id) =>
        userList.FirstOrDefault(u => u.Id == id)?.Name ?? id.ToString();
}