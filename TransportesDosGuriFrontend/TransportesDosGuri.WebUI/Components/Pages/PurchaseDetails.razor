@page "/purchase/{PurchaseId:long}"
@attribute [Authorize]

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces
@using TransportesDosGuri.Core.Enums
@using Microsoft.AspNetCore.Authorization

@inject IPurchaseService PurchaseService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Minha compra</PageTitle>

<div class="purchase-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="purchase-main">

        <div class="purchase-container">

            @if (loading)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Carregando compra...</p>
                </div>
            }
            else if (purchase == null)
            {
                <div class="state-box empty">

                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                            <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                    </div>

                    <h2>Compra não encontrada</h2>
                    <p>Não conseguimos localizar essa compra.</p>

                    <button class="primary-button" @onclick="GoBack">
                        Voltar para minhas viagens
                    </button>

                </div>
            }
            else
            {
                <!-- HEADER -->
                <header class="page-header">

                    <div class="header-text">

                        <button class="back-link" @onclick="GoBack">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M19 12H5M11 18l-6-6 6-6"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                            Voltar
                        </button>

                        <h1>
                            Compra
                            <span>#@purchase.Id.</span>
                        </h1>

                        <p>
                            Confira os dados da sua compra, assentos reservados e status do pagamento.
                        </p>

                    </div>

                    <span class="status-badge @GetStatusClass(purchase.Status)">
                        <span class="status-dot"></span>
                        @GetStatusText(purchase.Status)
                    </span>

                </header>

                <!-- MAIN CARD -->
                <section class="purchase-card">

                    <div class="stat-card-glow"></div>

                    <div class="card-header">

                        <div class="trip-icon">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M2 16l20-6-4 4-2 6-2-3-3 3 1-4-10-1z"
                                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M22 10 12 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <div class="card-title">
                            <span class="trip-id">Viagem</span>
                            <h2>@purchase.TripName</h2>
                        </div>

                    </div>

                    <div class="purchase-data">

                        <div class="data-item">
                            <span class="data-label">Data</span>
                            <span class="data-value">
                                @purchase.PurchaseDate.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <div class="data-divider"></div>

                        <div class="data-item">
                            <span class="data-label">Valor</span>
                            <span class="data-value data-value-highlight">
                                @purchase.PurchasePrice.ToString("C2")
                            </span>
                        </div>

                    </div>

                    <div class="reservations-section">

                        <div class="section-title">
                            <span>Seus assentos</span>
                            <span class="section-count">
                                @purchase.Reservations.Count
                            </span>
                        </div>

                        <div class="reservations">

                            @foreach (var reservation in purchase.Reservations)
                            {
                                <div class="reservation">

                                    <div class="reservation-seat">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M6 4v6a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V4"
                                                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                            <path d="M6 10v6a4 4 0 0 0 4 4h8"
                                                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                            <path d="M6 20H3M18 20h3"
                                                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        </svg>
                                        <strong>@reservation.SeatNumber</strong>
                                    </div>

                                    <div class="reservation-info">
                                        <span class="reservation-class">
                                            @GetClassName(reservation.Class)
                                        </span>
                                        <span class="reservation-flight">
                                            Voo #@reservation.FlightId
                                        </span>
                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                    @if (purchase.Status == PurchaseStatus.Pending)
                    {
                        <button class="primary-button payment-button"
                                @onclick="ProcessPayment"
                                disabled="@processingPayment">

                            @if (processingPayment)
                            {
                                <span class="button-spinner"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <rect x="2" y="5" width="20" height="14" rx="2"
                                          stroke="currentColor" stroke-width="1.8" />
                                    <path d="M2 10h20" stroke="currentColor" stroke-width="1.8" />
                                </svg>
                                <span>Pagar compra</span>
                            }

                        </button>
                    }

                    @if (purchase.Status == PurchaseStatus.Confirmed)
                    {
                        <button class="ghost-button receipt-button"
                                @onclick="DownloadReceipt">

                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M12 3v12M7 10l5 5 5-5"
                                      stroke="currentColor" stroke-width="1.8"
                                      stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M5 21h14"
                                      stroke="currentColor" stroke-width="1.8"
                                      stroke-linecap="round" />
                            </svg>

                            Baixar recibo

                        </button>
                    }

                </section>
            }

        </div>

    </main>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */
    .purchase-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* =========================================================
           BACKGROUND
        ========================================================= */
    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from { transform: translate3d(0,0,0) scale(1); }
        to   { transform: translate3d(40px,-30px,0) scale(1.08); }
    }

    /* =========================================================
           LAYOUT
        ========================================================= */
    .purchase-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .purchase-container {
        flex: 1;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    /* =========================================================
           HEADER
        ========================================================= */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    .header-text {
        max-width: 620px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
        padding: 6px 12px 6px 8px;
        border-radius: 999px;
        cursor: pointer;
        color: #a5b4fc;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        transition: all .25s ease;
    }

        .back-link svg {
            width: 14px;
            height: 14px;
            transition: transform .25s ease;
        }

        .back-link:hover {
            color: #c7d2fe;
            border-color: rgba(168,85,247,.35);
            background: rgba(79,70,229,.16);
        }

            .back-link:hover svg {
                transform: translateX(-3px);
            }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    /* =========================================================
           STATUS BADGE
        ========================================================= */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50%      { opacity: .45; }
    }

    .status-pending {
        color: #fcd34d;
        background: rgba(245,158,11,.10);
        border-color: rgba(245,158,11,.24);
    }

        .status-pending .status-dot {
            background: #fbbf24;
            box-shadow: 0 0 10px #fbbf24;
        }

    .status-confirmed {
        color: #6ee7b7;
        background: rgba(16,185,129,.10);
        border-color: rgba(16,185,129,.24);
    }

        .status-confirmed .status-dot {
            background: #34d399;
            box-shadow: 0 0 10px #34d399;
        }

    .status-canceled {
        color: #fca5a5;
        background: rgba(239,68,68,.10);
        border-color: rgba(239,68,68,.24);
    }

        .status-canceled .status-dot {
            background: #f87171;
            box-shadow: 0 0 10px #f87171;
        }

    .status-default {
        color: #cbd5e1;
        background: rgba(148,163,184,.10);
        border-color: rgba(148,163,184,.24);
    }

        .status-default .status-dot {
            background: #94a3b8;
            box-shadow: 0 0 10px #94a3b8;
        }

    /* =========================================================
           PURCHASE CARD
        ========================================================= */
    .purchase-card {
        position: relative;
        padding: 28px;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .stat-card-glow {
        position: absolute;
        width: 260px;
        height: 260px;
        top: -140px;
        right: -140px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: .55;
        pointer-events: none;
        background: rgba(99,102,241,.55);
    }

    /* card header */
    .card-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

    .trip-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #a5b4fc;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(99,102,241,.22);
        box-shadow: inset 0 1px rgba(255,255,255,.06);
    }

        .trip-icon svg {
            width: 22px;
            height: 22px;
        }

    .card-title {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .trip-id {
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .card-title h2 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.03em;
        line-height: 1.2;
        word-break: break-word;
    }

    /* purchase data */
    .purchase-data {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 22px 0;
    }

    @@media (min-width: 560px) {
        .purchase-data {
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }
    }

    .data-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .data-label {
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .data-value {
        color: #e2e8f0;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: -.01em;
    }

    .data-value-highlight {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: transparent;
        background: linear-gradient(90deg, #a5b4fc, #d8b4fe);
        background-clip: text;
        -webkit-background-clip: text;
        font-variant-numeric: tabular-nums;
    }

    .data-divider {
        display: none;
    }

    @@media (min-width: 560px) {
        .data-divider {
            display: block;
            width: 1px;
            height: 40px;
            background: rgba(255,255,255,.06);
        }
    }

    /* reservations section */
    .reservations-section {
        position: relative;
        z-index: 1;
        padding-top: 22px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .section-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 7px;
        border-radius: 999px;
        color: #a5b4fc;
        font-size: 10px;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(99,102,241,.22);
    }

    .reservations {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    @@media (min-width: 560px) {
        .reservations {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .reservation {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 16px;
        background: rgba(2,6,23,.42);
        border: 1px solid rgba(255,255,255,.06);
        transition: border-color .25s ease, background .25s ease;
    }

        .reservation:hover {
            border-color: rgba(168,85,247,.28);
            background: rgba(15,23,42,.55);
        }

    .reservation-seat {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

        .reservation-seat svg {
            width: 18px;
            height: 18px;
            color: #a5b4fc;
        }

        .reservation-seat strong {
            color: #ffffff;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: -.02em;
            font-variant-numeric: tabular-nums;
        }

    .reservation-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-left: 14px;
        border-left: 1px solid rgba(255,255,255,.06);
        min-width: 0;
    }

    .reservation-class {
        color: #e2e8f0;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: -.005em;
    }

    .reservation-flight {
        color: #64748b;
        font-size: 10.5px;
        letter-spacing: .02em;
    }

    /* =========================================================
           BUTTONS
        ========================================================= */
    .primary-button {
        position: relative;
        z-index: 1;
        margin-top: 24px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 50px;
        padding: 0 22px;
        border-radius: 14px;
        cursor: pointer;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .02em;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: 1px solid rgba(255,255,255,.10);
        box-shadow: 0 14px 32px rgba(99,102,241,.30), inset 0 1px rgba(255,255,255,.12);
        transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }

        .primary-button svg {
            width: 18px;
            height: 18px;
        }

        .primary-button:hover:not(:disabled) {
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 20px 42px rgba(147,51,234,.38), inset 0 1px rgba(255,255,255,.16);
        }

        .primary-button:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .ghost-button {
        position: relative;
        z-index: 1;
        margin-top: 24px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 50px;
        padding: 0 22px;
        border-radius: 14px;
        cursor: pointer;
        color: #cbd5e1;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .02em;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04);
        transition: all .25s ease;
    }

        .ghost-button svg {
            width: 18px;
            height: 18px;
        }

        .ghost-button:hover {
            color: #ffffff;
            border-color: rgba(168,85,247,.35);
            background: linear-gradient(135deg, rgba(79,70,229,.20), rgba(147,51,234,.14));
            box-shadow: 0 12px 30px rgba(99,102,241,.22), inset 0 1px rgba(255,255,255,.08);
        }

    .button-spinner {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.30);
        border-top-color: #ffffff;
        animation: spin .8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* =========================================================
           STATE BOX
        ========================================================= */
    .state-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 64px 24px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(15,23,42,.62), rgba(2,6,23,.48));
        border: 1px solid rgba(255,255,255,.06);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        text-align: center;
    }

        .state-box p {
            margin: 0;
            color: #64748b;
            font-size: 12.5px;
            letter-spacing: .02em;
        }

        .state-box h2 {
            margin: 6px 0 0;
            color: #ffffff;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -.03em;
        }

    .spinner {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 2px solid rgba(148,163,184,.20);
        border-top-color: #a855f7;
        animation: spin .8s linear infinite;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: #a5b4fc;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(99,102,241,.22);
    }

        .empty-icon svg {
            width: 26px;
            height: 26px;
        }

</style>

@code {

    [Parameter]
    public long PurchaseId { get; set; }

    private PurchaseDetailsDTO? purchase;

    private bool loading;

    private bool processingPayment;

    protected override async Task OnInitializedAsync()
    {
        await LoadPurchaseAsync();
    }

    private async Task LoadPurchaseAsync()
    {
        loading = true;

        try
        {
            purchase = await PurchaseService.GetMyPurchaseAsync(PurchaseId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar compra: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ProcessPayment()
    {
        if (processingPayment)
            return;

        processingPayment = true;

        try
        {
            var success = await PurchaseService.ProcessPaymentAsync(PurchaseId);

            if (success)
                await LoadPurchaseAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao processar pagamento: {ex.Message}");
        }
        finally
        {
            processingPayment = false;
        }
    }

    private async Task DownloadReceipt()
    {
        try
        {
            var pdf = await PurchaseService.DownloadReceiptAsync(PurchaseId);

            if (pdf == null)
                return;

            var base64 = Convert.ToBase64String(pdf);

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Passagem_{PurchaseId}.pdf",
                "application/pdf",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao baixar recibo: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-trips");
    }

    private string GetStatusText(PurchaseStatus status)
    {
        return status switch
        {
            PurchaseStatus.Pending => "Pendente",
            PurchaseStatus.Confirmed => "Confirmada",
            PurchaseStatus.Canceled => "Cancelada",
            _ => status.ToString()
        };
    }

    private string GetStatusClass(PurchaseStatus status)
    {
        return status switch
        {
            PurchaseStatus.Pending => "status-pending",
            PurchaseStatus.Confirmed => "status-confirmed",
            PurchaseStatus.Canceled => "status-canceled",
            _ => "status-default"
        };
    }

    private string GetClassName(SeatClass seatClass)
    {
        return seatClass switch
        {
            SeatClass.Economical => "Econômica",
            SeatClass.Executive => "Executiva",
            SeatClass.First => "Primeira Classe",
            _ => seatClass.ToString()
        };
    }

