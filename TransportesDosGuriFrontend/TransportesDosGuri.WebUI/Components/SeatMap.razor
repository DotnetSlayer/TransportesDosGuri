@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Enums

<div class="seat-map">

    @if (Seats is null || !Seats.Any())
    {
        <div class="seat-map-empty">
            <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                <path d="M12 8v4M12 16h.01"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <span>Nenhum assento disponível neste voo.</span>
        </div>
    }
    else
    {
        <div class="seat-legend">
            <span class="legend-item">
                <span class="legend-swatch legend-available"></span>
                Disponível
            </span>
            <span class="legend-item">
                <span class="legend-swatch legend-selected"></span>
                Selecionado
            </span>
            <span class="legend-item">
                <span class="legend-swatch legend-unavailable"></span>
                Indisponível
            </span>
        </div>

        <div class="seat-grid">

            @foreach (var seat in Seats.OrderBy(x => x.SeatNumber))
            {
                var isAvailable = seat.Status == FlightSeatStatus.Available;
                var isSelected = SelectedSeatIds.Contains(seat.Id);

                <button type="button"
                        class="seat @(isSelected
                            ? "seat-selected"
                            : isAvailable
                                ? "seat-available"
                                : "seat-unavailable")"
                        disabled="@(!isAvailable)"
                        @onclick="() => ToggleSeat(seat)">

                    <span class="seat-number">
                        @seat.SeatNumber
                    </span>

                    @if (isSelected)
                    {
                        <svg class="seat-check" viewBox="0 0 24 24" fill="none">
                            <path d="m5 12 5 5L20 7"
                                  stroke="currentColor"
                                  stroke-width="2.4"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                    }

                </button>
            }

        </div>
    }

</div>

<style>

    /* =========================================================
           SEAT MAP
        ========================================================= */
    .seat-map {
        display: flex;
        flex-direction: column;
        gap: 16px;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #e2e8f0;
    }

    /* =========================================================
           LEGEND
        ========================================================= */
    .seat-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .02em;
    }

    .legend-swatch {
        width: 11px;
        height: 11px;
        border-radius: 4px;
        border: 1px solid transparent;
        flex-shrink: 0;
    }

    .legend-available {
        background: rgba(16,185,129,.14);
        border-color: rgba(16,185,129,.35);
    }

    .legend-selected {
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border-color: rgba(255,255,255,.16);
        box-shadow: 0 0 10px rgba(147,51,234,.45);
    }

    .legend-unavailable {
        background: rgba(239,68,68,.10);
        border-color: rgba(239,68,68,.30);
    }

    /* =========================================================
           SEAT GRID
        ========================================================= */
    .seat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
        gap: 8px;
    }

    .seat {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 44px;
        padding: 6px 8px;
        border-radius: 11px;
        cursor: pointer;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: -.005em;
        font-variant-numeric: tabular-nums;
        transition: transform .2s ease, border-color .2s ease,
                    background .2s ease, box-shadow .2s ease, color .2s ease;
    }

        .seat:disabled {
            cursor: not-allowed;
        }

    /* available */
    .seat-available {
        color: #6ee7b7;
        background: rgba(16,185,129,.06);
        border: 1px solid rgba(16,185,129,.30);
    }

        .seat-available:hover {
            transform: translateY(-2px);
            color: #a7f3d0;
            background: rgba(16,185,129,.14);
            border-color: rgba(16,185,129,.55);
            box-shadow: 0 8px 20px rgba(16,185,129,.20);
        }

    /* selected */
    .seat-selected {
        color: #ffffff;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 24px rgba(147,51,234,.35),
                    inset 0 1px rgba(255,255,255,.18);
    }

        .seat-selected:hover {
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 14px 30px rgba(147,51,234,.45),
                        inset 0 1px rgba(255,255,255,.22);
        }

    /* unavailable */
    .seat-unavailable {
        color: #64748b;
        background: rgba(239,68,68,.05);
        border: 1px solid rgba(239,68,68,.20);
        opacity: .55;
        text-decoration: line-through;
        text-decoration-color: rgba(239,68,68,.45);
    }

    .seat-number {
        line-height: 1;
    }

    .seat-check {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
    }

    /* =========================================================
           EMPTY STATE
        ========================================================= */
    .seat-map-empty {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 20px;
        border-radius: 14px;
        color: #fcd34d;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .01em;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.22);
    }

        .seat-map-empty svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            color: #fbbf24;
        }

</style>

@code {

    [Parameter]
    public List<FlightSeatDTO> Seats { get; set; } = new();

    [Parameter]
    public HashSet<long> SelectedSeatIds { get; set; } = new();

    [Parameter]
    public EventCallback<long> OnSeatSelected { get; set; }

    private async Task ToggleSeat(FlightSeatDTO seat)
    {
        if (seat.Status != FlightSeatStatus.Available)
            return;

        await OnSeatSelected.InvokeAsync(seat.Id);
    }

}