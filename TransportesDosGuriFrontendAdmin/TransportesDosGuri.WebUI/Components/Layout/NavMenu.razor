@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using TransportesDosGuri.Core.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<button type="button"
        class="hamburger-btn"
        @onclick="ToggleSidebar"
        aria-label="Abrir menu">
    <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round" />
    </svg>
</button>

@if (sidebarOpen)
{
    <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
}

<aside class="admin-sidebar @(sidebarOpen ? "is-open" : "")">

    <div class="sidebar-effects">
        <div class="sidebar-orb sidebar-orb-indigo"></div>
        <div class="sidebar-orb sidebar-orb-purple"></div>
        <div class="sidebar-grid"></div>
    </div>

    <div class="sidebar-header">
        <div class="sidebar-logo">

            <div class="logo-text">
                <strong>Transportes Dos Guri</strong>
                <span>ADMIN</span>
            </div>
        </div>

        <button type="button"
                class="sidebar-close-btn"
                @onclick="CloseSidebar"
                aria-label="Fechar menu">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M18 6L6 18M6 6l12 12"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <nav class="sidebar-nav">

        <div class="nav-group">
            <p class="nav-label">Operações</p>
            <NavLink href="adminHome" Match="NavLinkMatch.All" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span>
                <span class="nav-text">Dashboard</span>
            </NavLink>
            <NavLink href="adminAircrafts" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Aeronaves</span>
            </NavLink>
            <NavLink href="adminFlights" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Voos</span>
            </NavLink>
            <NavLink href="adminAirports" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Aeroportos</span>
            </NavLink>
            <NavLink href="adminSchedules" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Escalas</span>
            </NavLink>
            <NavLink href="adminTrips" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Viagens</span>
            </NavLink>
            <NavLink href="adminSeats" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Assentos</span>
            </NavLink>
            <NavLink href="adminFlightSeats" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Assentos de Voos</span>
            </NavLink>
        </div>

        <div class="nav-group">
            <p class="nav-label">Comercial</p>
            <NavLink href="adminPurchases" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Compras</span>
            </NavLink>
            <NavLink href="adminReservations" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Reservas</span>
            </NavLink>
        </div>

        <div class="nav-group">
            <p class="nav-label">Sistema</p>
            <NavLink href="adminUsers" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Usuários</span>
            </NavLink>
            <NavLink href="adminUserRequests" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Solicitações</span>
            </NavLink>
            <NavLink href="adminAsaasIntegrations" class="nav-item" @onclick="CloseSidebar">
                <span class="nav-dot"></span><span class="nav-text">Integrações Asaas</span>
            </NavLink>
        </div>

        <div class="nav-group">
            <p class="nav-label">Conta</p>

            @if (!isAuthenticated)
            {
                <NavLink href="account/login" class="nav-item" @onclick="CloseSidebar">
                    <span class="nav-dot"></span><span class="nav-text">Login</span>
                </NavLink>
                <NavLink href="account/register" class="nav-item" @onclick="CloseSidebar">
                    <span class="nav-dot"></span><span class="nav-text">Registrar-se</span>
                </NavLink>
            }
            else
            {
                <button type="button" @onclick="Logout" class="nav-item nav-item-button">
                    <span class="nav-dot"></span><span class="nav-text">Sair</span>
                </button>
            }
        </div>

    </nav>

    <div class="sidebar-user">
        <div class="user-avatar">
            @GetInitials(userName)
        </div>
        <div class="user-info">
            <span class="user-status"></span>
            <span class="user-name">@userName</span>
        </div>
    </div>

</aside>

<style>

    .admin-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 240px;
        z-index: 100;

        display: flex;
        flex-direction: column;

        background: #03050b;
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        overflow: hidden;

        transform: translateX(-100%);
        transition: transform .3s cubic-bezier(.4, 0, .2, 1);
    }

    .admin-sidebar.is-open {
        transform: translateX(0);
    }

    @@media (min-width: 1024px) {
        .admin-sidebar {
            transform: translateX(0);
        }

        .hamburger-btn,
        .sidebar-overlay,
        .sidebar-close-btn {
            display: none !important;
        }
    }

    .hamburger-btn {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 110;

        width: 40px;
        height: 40px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;
        cursor: pointer;

        color: #cbd5e1;
        background: linear-gradient(135deg, rgba(15,23,42,.9), rgba(2,6,23,.8));
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 8px 22px rgba(0,0,0,.35);

        backdrop-filter: blur(12px);
        transition: all .2s ease;
    }

    .hamburger-btn:hover {
        color: #ffffff;
        border-color: rgba(168,85,247,.35);
    }

    .hamburger-btn svg {
        width: 18px;
        height: 18px;
    }

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        z-index: 99;

        background: rgba(2, 6, 23, .65);
        backdrop-filter: blur(2px);

        animation: fadeIn .2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .sidebar-close-btn {
        position: absolute;
        top: 14px;
        right: 14px;

        width: 32px;
        height: 32px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;
        cursor: pointer;

        color: #94a3b8;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.07);

        transition: all .2s ease;
    }

    .sidebar-close-btn:hover {
        color: #ffffff;
        border-color: rgba(168,85,247,.30);
        background: rgba(139,92,246,.10);
    }

    .sidebar-close-btn svg {
        width: 16px;
        height: 16px;
    }

    .sidebar-effects {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .sidebar-orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(90px);
        opacity: 0.28;
        animation: sidebarFloat 14s ease-in-out infinite alternate;
    }

    .sidebar-orb-indigo {
        width: 260px;
        height: 260px;
        background: #4f46e5;
        left: -140px;
        top: -100px;
    }

    .sidebar-orb-purple {
        width: 280px;
        height: 280px;
        background: #9333ea;
        right: -160px;
        bottom: -120px;
        animation-delay: -5s;
    }

    .sidebar-grid {
        position: absolute;
        inset: 0;
        opacity: 0.03;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 42px 42px;
    }

    @@keyframes sidebarFloat {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(30px,-25px,0) scale(1.08);
        }
    }

    .sidebar-header {
        position: relative;
        z-index: 1;
        padding: 18px 16px 14px;
        border-bottom: 1px solid rgba(255,255,255,.05);
        flex-shrink: 0;
    }

    .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .logo-mark {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #c4b5fd;
        background: linear-gradient(135deg, rgba(79,70,229,.22), rgba(147,51,234,.18));
        border: 1px solid rgba(139,92,246,.25);
        box-shadow: inset 0 1px rgba(255,255,255,.08), 0 8px 22px rgba(99,102,241,.18);
    }

        .logo-mark svg {
            width: 18px;
            height: 18px;
        }

    .logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
        min-width: 0;
    }

        .logo-text strong {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: -.015em;
            color: #f8fafc;
        }

        .logo-text span {
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: #64748b;
            margin-top: 3px;
        }

    .sidebar-nav {
        position: relative;
        z-index: 1;
        flex: 1;
        overflow-y: auto;
        padding: 14px 10px 18px;
        scrollbar-width: thin;
        scrollbar-color: rgba(148,163,184,.2) transparent;
    }

        .sidebar-nav::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar-nav::-webkit-scrollbar-thumb {
            background: rgba(148,163,184,.18);
            border-radius: 999px;
        }

        .sidebar-nav::-webkit-scrollbar-track {
            background: transparent;
        }

    .nav-group + .nav-group {
        margin-top: 14px;
    }

    .nav-label {
        margin: 0;
        padding: 6px 12px 7px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #475569;
    }

    .nav-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 9px 12px;
        margin-bottom: 2px;
        border-radius: 11px;
        border: 1px solid transparent;
        background: transparent;
        color: #94a3b8;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: .01em;
        text-decoration: none;
        cursor: pointer;
        transition: all .22s ease;
    }

        .nav-item:hover {
            color: #e2e8f0;
            background: linear-gradient(135deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
            border-color: rgba(255,255,255,.06);
            transform: translateX(2px);
        }

        .nav-item.active {
            color: #ffffff;
            background: linear-gradient(120deg, rgba(79,70,229,.75), rgba(147,51,234,.65) 60%, rgba(245,158,11,.35));
            border-color: rgba(168,85,247,.35);
            box-shadow: 0 10px 24px rgba(99,102,241,.22), inset 0 1px rgba(255,255,255,.15);
        }

            .nav-item.active .nav-dot {
                background: #ffffff;
                box-shadow: 0 0 12px rgba(255,255,255,.9);
            }

            .nav-item.active .nav-text {
                color: #ffffff;
            }

    .nav-dot {
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #334155;
        transition: all .22s ease;
    }

    .nav-item:hover .nav-dot {
        background: #a78bfa;
        box-shadow: 0 0 10px rgba(167,139,250,.7);
    }

    .nav-text {
        flex: 1;
        text-align: left;
    }

    .nav-item-button {
        font-family: inherit;
    }

    .sidebar-user {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px 16px;
        border-top: 1px solid rgba(255,255,255,.06);
        background: linear-gradient(180deg, transparent, rgba(2,6,23,.55));
        backdrop-filter: blur(10px);
        flex-shrink: 0;
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 12px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: .02em;
        background: linear-gradient(135deg, #4f46e5, #9333ea 60%, #f59e0b);
        box-shadow: 0 8px 20px rgba(124,58,237,.30), inset 0 1px rgba(255,255,255,.20);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
    }

    .user-status {
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 10px #4ade80;
        animation: statusPulse 2.4s ease-in-out infinite;
    }

    @@keyframes statusPulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .user-name {
        font-size: 11.5px;
        font-weight: 700;
        color: #cbd5e1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private bool isAuthenticated = false;
    private string userName = "Visitante";
    private bool sidebarOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            isAuthenticated = true;
            userName = user.FindFirst("name")?.Value
                     ?? user.FindFirst(ClaimTypes.Name)?.Value
                     ?? user.FindFirst("given_name")?.Value
                     ?? "Operador";
        }
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name) || name == "Visitante")
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();

        NavigationManager.NavigateTo("api/auth/logout", forceLoad: true);
    }
}