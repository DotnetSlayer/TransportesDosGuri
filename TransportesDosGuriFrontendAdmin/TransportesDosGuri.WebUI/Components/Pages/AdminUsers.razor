@page "/adminUsers"
@rendermode InteractiveServer

@inject IUserService UserService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<PageTitle>Transportes Dos Guri · Usuários</PageTitle>

<div class="users-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="users-main">

        <div class="users-container">

            <!-- HEADER -->
            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Usuários.</span>
                    </h1>
                    <p>
                        Cadastre, edite e gerencie as contas da plataforma Transportes dos Guri.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(users?.Count ?? 0)</span>
                    <span class="counter-label">Usuários</span>
                </div>

            </header>

            <!-- FORM CARD -->
            <section class="form-card @(isEditing ? "form-card-editing" : "")">

                <div class="form-card-glow"></div>

                <div class="form-header">

                    <div class="section-label">
                        <span>@(isEditing ? "02" : "01")</span>
                        @(isEditing ? "Editando usuário" : "Novo usuário")
                    </div>

                    @if (isEditing)
                    {
                        <div class="editing-badge">
                            <span class="editing-dot"></span>
                            Editando <strong>#@selectedUserId</strong>
                        </div>
                    }

                </div>

                @if (isEditing)
                {
                    <EditForm Model="updateForm" OnValidSubmit="SaveUpdate">
                        <DataAnnotationsValidator />

                        <!-- SECTION: DADOS PESSOAIS -->
                        <div class="subsection">
                            <div class="subsection-label">Dados pessoais</div>

                            <div class="form-grid form-grid-3">

                                <div class="field">
                                    <label>Nome</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                                <circle cx="9" cy="7" r="4"
                                                        stroke="currentColor"
                                                        stroke-width="1.7" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="updateForm.Name"
                                                   placeholder="Nome" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Sobrenome</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                                <circle cx="9" cy="7" r="4"
                                                        stroke="currentColor"
                                                        stroke-width="1.7" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="updateForm.LastName"
                                                   placeholder="Sobrenome" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Telefone</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-mono"
                                                   @bind-Value="updateForm.PhoneNumber"
                                                   placeholder="(00) 00000-0000" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>CPF / Documento</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <rect x="3" y="5" width="18" height="14" rx="2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />
                                                <path d="M3 10h18M7 15h4"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-mono"
                                                   @bind-Value="updateForm.IdentityNumber"
                                                   placeholder="000.000.000-00" />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SECTION: ENDEREÇO -->
                        <div class="subsection">
                            <div class="subsection-label">Endereço</div>

                            <div class="form-grid form-grid-3">

                                <div class="field">
                                    <label>CEP</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 9l9-6 9 6v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M9 21V12h6v9"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-mono"
                                                   @bind-Value="updateForm.ZipCode"
                                                   placeholder="00000-000" />
                                    </div>
                                </div>

                                <div class="field field-full">
                                    <label>Logradouro</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M4 21V8l8-5 8 5v13M4 21h16"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="updateForm.Address"
                                                   placeholder="Rua / Avenida" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Número</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M4 9h16M4 15h16M10 3L8 21M16 3l-2 18"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputNumber class="input input-mono"
                                                     @bind-Value="updateForm.AddressNumber"
                                                     placeholder="123" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Bairro</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="updateForm.District"
                                                   placeholder="Bairro" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Cidade</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="updateForm.City"
                                                   placeholder="Cidade" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>UF</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M9 3v15M15 6v15"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-uppercase"
                                                   @bind-Value="updateForm.State"
                                                   maxlength="2"
                                                   placeholder="SP" />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="form-actions">
                            <button type="button" @onclick="ResetForm" class="btn-secondary">
                                Cancelar
                            </button>

                            <button type="submit" class="btn-primary">
                                <span>Atualizar usuário</span>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>

                    </EditForm>
                }
                else
                {
                    <EditForm Model="registerForm" OnValidSubmit="SaveRegister">
                        <DataAnnotationsValidator />

                        <!-- SECTION: DADOS PESSOAIS -->
                        <div class="subsection">
                            <div class="subsection-label">Dados pessoais</div>

                            <div class="form-grid form-grid-3">

                                <div class="field">
                                    <label>Nome</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                                <circle cx="9" cy="7" r="4"
                                                        stroke="currentColor"
                                                        stroke-width="1.7" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="registerForm.Name"
                                                   placeholder="Nome" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Sobrenome</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                                <circle cx="9" cy="7" r="4"
                                                        stroke="currentColor"
                                                        stroke-width="1.7" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="registerForm.LastName"
                                                   placeholder="Sobrenome" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>CPF / Documento</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <rect x="3" y="5" width="18" height="14" rx="2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />
                                                <path d="M3 10h18M7 15h4"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-mono"
                                                   @bind-Value="registerForm.IdentityNumber"
                                                   placeholder="000.000.000-00" />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SECTION: ACESSO -->
                        <div class="subsection">
                            <div class="subsection-label">Acesso</div>

                            <div class="form-grid form-grid-2">

                                <div class="field">
                                    <label>E-mail</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />
                                                <path d="m3 7 9 6 9-6"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   type="email"
                                                   @bind-Value="registerForm.Email"
                                                   placeholder="seu@email.com" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Senha</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <rect x="4" y="10" width="16" height="11" rx="2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />
                                                <path d="M8 10V7a4 4 0 0 1 8 0v3"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   type="password"
                                                   @bind-Value="registerForm.Password"
                                                   placeholder="Senha de acesso" />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SECTION: ENDEREÇO -->
                        <div class="subsection">
                            <div class="subsection-label">Endereço</div>

                            <div class="form-grid form-grid-3">

                                <div class="field">
                                    <label>CEP</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 9l9-6 9 6v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M9 21V12h6v9"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-mono"
                                                   @bind-Value="registerForm.ZipCode"
                                                   placeholder="00000-000" />
                                    </div>
                                </div>

                                <div class="field field-full">
                                    <label>Logradouro</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M4 21V8l8-5 8 5v13M4 21h16"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="registerForm.Address"
                                                   placeholder="Rua / Avenida" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Número</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M4 9h16M4 15h16M10 3L8 21M16 3l-2 18"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputNumber class="input input-mono"
                                                     @bind-Value="registerForm.AddressNumber"
                                                     placeholder="123" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Bairro</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="registerForm.District"
                                                   placeholder="Bairro" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>Cidade</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input"
                                                   @bind-Value="registerForm.City"
                                                   placeholder="Cidade" />
                                    </div>
                                </div>

                                <div class="field">
                                    <label>UF</label>
                                    <div class="input-wrapper">
                                        <span class="input-icon">
                                            <svg viewBox="0 0 24 24" fill="none">
                                                <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                                <path d="M9 3v15M15 6v15"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />
                                            </svg>
                                        </span>
                                        <InputText class="input input-uppercase"
                                                   @bind-Value="registerForm.State"
                                                   maxlength="2"
                                                   placeholder="SP" />
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="form-actions">
                            <button type="submit" class="btn-primary">
                                <span>Cadastrar usuário</span>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>

                    </EditForm>
                }

            </section>

            <!-- TABLE CARD -->
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Usuários cadastrados
                    </div>
                </div>

                @if (users == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando usuários...</span>
                    </div>
                }
                else if (!users.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round" />
                            <circle cx="9" cy="7" r="4"
                                    stroke="currentColor"
                                    stroke-width="1.6" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round" />
                        </svg>
                        <span>Nenhum usuário cadastrado.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th>Usuário</th>
                                    <th>E-mail</th>
                                    <th class="col-doc">Documento</th>
                                    <th>Localização</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@user.Id</span>
                                        </td>

                                        <td>
                                            <div class="user-cell">
                                                <span class="user-avatar">
                                                    @GetInitials(user.FullName)
                                                </span>
                                                <span class="user-name">@user.FullName</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="email-value">@user.Email</span>
                                        </td>

                                        <td class="col-doc">
                                            @if (string.IsNullOrEmpty(user.IdentityNumber))
                                            {
                                                <span class="doc-empty">—</span>
                                            }
                                            else
                                            {
                                                <span class="doc-chip">@user.IdentityNumber</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="location-chip">
                                                <svg viewBox="0 0 24 24" fill="none">
                                                    <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                                          stroke="currentColor"
                                                          stroke-width="1.7"
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round" />
                                                    <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                                          stroke="currentColor"
                                                          stroke-width="1.7"
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round" />
                                                </svg>
                                                @user.City/@user.State
                                            </span>
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => StartEdit(user)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(user.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
