@page "/adminUserRequests"
@attribute [Authorize]
@rendermode InteractiveServer

@inject IUserRequestService UserRequestService
@inject IUserService UserService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces
@using Microsoft.AspNetCore.Authorization

<PageTitle>Transportes Dos Guri</PageTitle>

<div class="requests-page">

    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="requests-main">

        <div class="requests-container">

            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Solicitações.</span>
                    </h1>
                    <p>
                        Gerencie as cobranças vinculadas às assinaturas Asaas dos usuários.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(userRequests?.Count ?? 0)</span>
                    <span class="counter-label">Solicitações</span>
                </div>

            </header>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                        <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <span>@errorMessage</span>
                    <button @onclick="() => errorMessage = null" class="close-btn">×</button>
                </div>
            }

          
            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(requestForm.Id == 0 ? "01" : "02")</span>
                        @(requestForm.Id == 0 ? "Nova solicitação" : "Editando solicitação")
                    </div>
                </div>

                <EditForm Model="requestForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                   
                    <div class="subsection">
                        <div class="subsection-label">Cobrança</div>

                        <div class="form-grid form-grid-3">

                            <div class="field">
                                <label>Usuário</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round" />
                                            <circle cx="9" cy="7" r="4"
                                                    stroke="currentColor"
                                                    stroke-width="1.7" />
                                        </svg>
                                    </span>
                                    <InputSelect class="input" @bind-Value="requestForm.ApplicationUserId">
                                        <option value="0">Selecione o usuário...</option>
                                        @foreach (var user in userList)
                                        {
                                            <option value="@user.Id">@user.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="field">
                                <label>Preço (R$)</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputNumber class="input input-mono"
                                                 @bind-Value="requestForm.Price"
                                                 step="0.01"
                                                 placeholder="0,00" />
                                </div>
                            </div>

                            <div class="field">
                                <label>Vencimento</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputDate class="input input-mono"
                                               @bind-Value="requestForm.DueDate" />
                                </div>
                            </div>

                        </div>
                    </div>

                  
                    <div class="subsection">
                        <div class="subsection-label">Integração</div>

                        <div class="form-grid">

                            <div class="field">
                                <label>ID da assinatura Asaas</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <InputText class="input input-mono"
                                               @bind-Value="requestForm.AsaasSubscriptionId"
                                               placeholder="sub_xxxxxxxxxxxx" />
                                </div>
                            </div>

                        </div>
                    </div>

                    
                    <div class="form-actions">
                        @if (requestForm.Id != 0)
                        {
                            <button type="button" @onclick="ResetForm" class="btn-secondary">
                                Cancelar
                            </button>
                        }

                        <button type="submit" class="btn-primary">
                            <span>@(requestForm.Id == 0 ? "Criar solicitação" : "Atualizar solicitação")</span>
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M5 12h14M13 6l6 6-6 6"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                </EditForm>

            </section>

           
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Solicitações registradas
                    </div>
                </div>

                @if (userRequests == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando solicitações...</span>
                    </div>
                }
                else if (!userRequests.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M9 12h6m-6 4h6M9 8h6M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhuma solicitação registrada.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th>Usuário</th>
                                    <th class="col-price">Valor</th>
                                    <th>Vencimento</th>
                                    <th class="col-asaas">Assinatura Asaas</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in userRequests)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@item.Id</span>
                                        </td>

                                        <td>
                                            <div class="user-cell">
                                                <span class="user-avatar">
                                                    @GetUserInitials(item.ApplicationUserId)
                                                </span>
                                                <span class="user-name">@GetUserDisplay(item.ApplicationUserId)</span>
                                            </div>
                                        </td>

                                        <td class="col-price">
                                            <span class="price-value">@item.Price.ToString("C")</span>
                                        </td>

                                        <td>
                                            <span class="due-badge @GetDueVariant(item.DueDate)">
                                                <svg viewBox="0 0 24 24" fill="none">
                                                    <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                          stroke="currentColor"
                                                          stroke-width="1.7"
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round" />
                                                </svg>
                                                @item.DueDate.ToString("dd/MM/yyyy")
                                            </span>
                                        </td>

                                        <td class="col-asaas">
                                            @if (string.IsNullOrEmpty(item.AsaasSubscriptionId))
                                            {
                                                <span class="asaas-empty">—</span>
                                            }
                                            else
                                            {
                                                <span class="asaas-chip">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                                              stroke="currentColor"
                                                              stroke-width="1.7"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                                              stroke="currentColor"
                                                              stroke-width="1.7"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    @item.AsaasSubscriptionId
                                                </span>
                                            }
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    .requests-page {
        position: relative;
        min-height: 100%;
        width: 100%;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .background-effects {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    .requests-main {
        position: relative;
        z-index: 1;
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }

    .requests-container {
        flex: 1;
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .alert-error {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 14px;
        background: rgba(244, 63, 94, .10);
        border: 1px solid rgba(244, 63, 94, .30);
        color: #fda4af;
        font-size: 13px;
        font-weight: 600;
        animation: slideDown .3s ease;
    }

        .alert-error svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .alert-error .close-btn {
            margin-left: auto;
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            font-size: 20px;
            line-height: 1;
            padding: 0;
            opacity: .7;
            transition: opacity .2s;
        }

            .alert-error .close-btn:hover {
                opacity: 1;
            }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        top: -190px;
        right: -190px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    .subsection {
        position: relative;
        z-index: 1;
        margin-bottom: 22px;
    }

        .subsection:last-of-type {
            margin-bottom: 0;
        }

    .subsection-label {
        display: inline-block;
        margin-bottom: 12px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #475569;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    @@media (min-width: 640px) {
        .form-grid-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
        appearance: none;
    }

    .input-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12.5px;
    }

    .input::placeholder {
        color: #475569;
    }

    .input:hover {
        border-color: rgba(148,163,184,.16);
    }

    .input:focus {
        border-color: rgba(168,85,247,.55);
        background: rgba(15,23,42,.86);
        box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
    }

    select.input {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 16px;
        padding-right: 42px;
    }

        select.input option {
            background: #0f172a;
            color: #e2e8f0;
        }

    input[type="date"].input::-webkit-calendar-picker-indicator,
    input[type="datetime-local"].input::-webkit-calendar-picker-indicator {
        filter: invert(.6);
        cursor: pointer;
    }

    input[type="number"].input::-webkit-outer-spin-button,
    input[type="number"].input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"].input {
        -moz-appearance: textfield;
    }

    .form-actions {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 24px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient(110deg, #4f46e5, #9333ea 55%, #f59e0b);
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary svg {
            width: 15px;
            height: 15px;
            transition: transform .25s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .btn-primary:hover svg {
                transform: translateX(4px);
            }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 18px;
