@code {
    private List<UserRequestDTO>? userRequests;
    private List<UserDTO> userList = new();
    private UserRequestDTO requestForm = new() { DueDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7)) };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadUserRequests();
    }

    private async Task LoadUsers() => userList = await UserService.GetAllAsync() ?? new();
    private async Task LoadUserRequests() => userRequests = await UserRequestService.GetAllAsync();

    private async Task Save()
    {
        errorMessage = null;

        if (requestForm.ApplicationUserId <= 0)
        {
            errorMessage = "Selecione um usuário válido.";
            return;
        }

        if (requestForm.Price <= 0)
        {
            errorMessage = "Informe um preço válido.";
            return;
        }

        try
        {
            if (requestForm.Id == 0)
                await UserRequestService.CreateAsync(requestForm);
            else
                await UserRequestService.UpdateAsync(requestForm.Id, requestForm);

            ResetForm();
            await LoadUserRequests();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao salvar solicitação: {ex.Message}";
        }
    }

    private void Edit(UserRequestDTO item)
    {
        requestForm = new UserRequestDTO
        {
            Id = item.Id,
            Price = item.Price,
            DueDate = item.DueDate,
            ApplicationUserId = item.ApplicationUserId,
            AsaasSubscriptionId = item.AsaasSubscriptionId
        };
    }

    private async Task Delete(long id)
    {
        errorMessage = null;

        var (success, error) = await UserRequestService.DeleteAsync(id);

        if (!success)
        {
            errorMessage = error;
            return;
        }

        await LoadUserRequests();
    }

    private void ResetForm() => requestForm = new UserRequestDTO { DueDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7)) };

    private string GetUserDisplay(long id) =>
        userList.FirstOrDefault(u => u.Id == id)?.Name ?? id.ToString();

    private string GetUserInitials(long userId)
    {
        var user = userList.FirstOrDefault(u => u.Id == userId);
        if (user == null || string.IsNullOrWhiteSpace(user.Name))
            return "?";

        var parts = user.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private string GetDueVariant(DateOnly dueDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);

        if (dueDate < today)
            return "due-overdue";      

        if (dueDate <= today.AddDays(7))
            return "due-soon";         

        return "due-ok";              
    }
}