@page "/adminAircrafts"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

@inject IAircraftService AircraftService

@inject IAircraftService AircraftService

<PageTitle>Transportes Dos Guri · Frota</PageTitle>

<div class="aircraft-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="aircraft-main">

        <div class="aircraft-container">

            <!-- HEADER -->
            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Aeronaves.</span>
                    </h1>
                    <p>
                        Cadastre, edite e gerencie todos os modelos da frota da Transportes dos Guri.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(aircrafts?.Count ?? 0)</span>
                    <span class="counter-label">Modelos</span>
                </div>

            </header>

            <!-- FORM CARD -->
            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(aircraftForm.Id == 0 ? "01" : "02")</span>
                        @(aircraftForm.Id == 0 ? "Nova aeronave" : "Editando aeronave")
                    </div>
                </div>

                <EditForm Model="aircraftForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="form-grid">

                        <div class="field">
                            <label>Modelo</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputText class="input" @bind-Value="aircraftForm.Model" placeholder="Ex: B737-800" />
                            </div>
                        </div>

                        <div class="field">
                            <label>Tipo</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M4 6h16M4 12h16M4 18h16"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputSelect class="input" @bind-Value="aircraftForm.Type">
                                    @foreach (var type in Enum.GetValues<AircraftType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary">
                                <span>@(aircraftForm.Id == 0 ? "Salvar" : "Atualizar")</span>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                            </button>

                            @if (aircraftForm.Id != 0)
                            {
                                <button type="button" @onclick="ResetForm" class="btn-secondary">
                                    Cancelar
                                </button>
                            }
                        </div>

                    </div>
                </EditForm>

            </section>

            <!-- TABLE -->
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Frota registrada
                    </div>
                </div>

                @if (aircrafts == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando aeronaves...</span>
                    </div>
                }
                else if (!aircrafts.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhuma aeronave registrada.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th>Modelo</th>
                                    <th>Tipo</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in aircrafts)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@item.Id</span>
                                        </td>
                                        <td class="col-model">
                                            <div class="model-cell">
                                                <span class="model-icon">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                </span>
                                                <span class="model-name">@item.Model</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="type-badge">@item.Type</span>
                                        </td>
                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */
    .aircraft-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* =========================================================
           BACKGROUND
        ========================================================= */
    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    /* =========================================================
           LAYOUT
        ========================================================= */
    .aircraft-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .aircraft-container {
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* =========================================================
           HEADER
        ========================================================= */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    /* counter */
    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    /* =========================================================
           FORM CARD
        ========================================================= */
    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        top: -180px;
        right: -180px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 18px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    .form-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr 1fr auto;
            align-items: end;
        }
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
        appearance: none;
    }

        .input::placeholder {
            color: #475569;
        }

        .input:hover {
            border-color: rgba(148,163,184,.16);
        }

        .input:focus {
            border-color: rgba(168,85,247,.55);
            background: rgba(15,23,42,.86);
            box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
        }

    select.input {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 16px;
        padding-right: 42px;
    }

        select.input option {
            background: #0f172a;
            color: #e2e8f0;
        }

    /* form actions */
    .form-actions {
        display: flex;
        gap: 10px;
        align-items: stretch;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 48px;
        padding: 0 22px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient(110deg, #4f46e5, #9333ea 55%, #f59e0b);
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary svg {
            width: 16px;
            height: 16px;
            transition: transform .25s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .btn-primary:hover svg {
                transform: translateX(4px);
            }

        .btn-primary:active {
            transform: translateY(0);
        }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        padding: 0 18px;
        border-radius: 13px;
        cursor: pointer;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        transition: all .22s ease;
    }

        .btn-secondary:hover {
            color: #cbd5e1;
            border-color: rgba(148,163,184,.25);
            background: linear-gradient(135deg, rgba(30,41,59,.76), rgba(15,23,42,.58));
        }

    /* =========================================================
           TABLE CARD
        ========================================================= */
    .table-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .table-card-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        bottom: -180px;
        left: -180px;
        border-radius: 50%;
        background: rgba(147,51,234,.28);
        filter: blur(90px);
        pointer-events: none;
    }

    .table-header {
        position: relative;
        z-index: 1;
        margin-bottom: 18px;
    }

    /* =========================================================
           DATA TABLE
        ========================================================= */
    .table-scroll {
        position: relative;
        z-index: 1;
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        .data-table thead th {
            text-align: left;
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: #64748b;
            border-bottom: 1px solid rgba(255,255,255,.06);
            white-space: nowrap;
        }

        .data-table tbody tr {
            transition: background .2s ease;
        }

            .data-table tbody tr:hover {
                background: rgba(255,255,255,.025);
            }

        .data-table tbody td {
            padding: 14px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            color: #cbd5e1;
            vertical-align: middle;
        }

        .data-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .col-id {
        width: 90px;
    }

    .col-actions {
        text-align: right;
        white-space: nowrap;
    }

    /* id chip */
    .id-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: #a5b4fc;
        background: rgba(99,102,241,.10);
        border: 1px solid rgba(99,102,241,.18);
    }

    /* model cell */
    .model-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .model-icon {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #c4b5fd;
        background: rgba(139,92,246,.10);
        border: 1px solid rgba(139,92,246,.15);
    }

        .model-icon svg {
            width: 15px;
            height: 15px;
        }

    .model-name {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        font-weight: 600;
        color: #f1f5f9;
        letter-spacing: -.005em;
    }

    /* type badge */
    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #cbd5e1;
        background: rgba(148,163,184,.08);
        border: 1px solid rgba(148,163,184,.14);
    }

    /* row actions */
    .row-actions {
        display: inline-flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .action-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 9px;
        cursor: pointer;
        color: #94a3b8;
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.06);
        font-size: 11px;
        font-weight: 700;
        font-family: inherit;
        transition: all .2s ease;
    }

        .action-link svg {
            width: 13px;
            height: 13px;
        }

        .action-link:hover {
            color: #c4b5fd;
            border-color: rgba(168,85,247,.30);
            background: rgba(139,92,246,.08);
        }

    .action-danger:hover {
        color: #fda4af;
        border-color: rgba(244,63,94,.28);
        background: rgba(244,63,94,.08);
    }

    /* =========================================================
           EMPTY / LOADING STATES
        ========================================================= */
    .state-empty {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 48px 20px;
        color: #475569;
        font-size: 12.5px;
        text-align: center;
    }

        .state-empty svg {
            width: 34px;
            height: 34px;
            color: #334155;
        }

    .spinner {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid rgba(148,163,184,.15);
        border-top-color: #a855f7;
        animation: spin .8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

</style>

@code {
    private List<AircraftDTO>? aircrafts;
    private AircraftDTO aircraftForm = new();

    protected override async Task OnInitializedAsync() => await LoadAircrafts();

    private async Task LoadAircrafts() => aircrafts = await AircraftService.GetAllAsync();

    private async Task Save()
    {
        if (aircraftForm.Id == 0)
            await AircraftService.CreateAsync(aircraftForm);
        else
            await AircraftService.UpdateAsync(aircraftForm.Id, aircraftForm);

        ResetForm();
        await LoadAircrafts();
    }

    private void Edit(AircraftDTO item)
    {
        aircraftForm = new AircraftDTO { Id = item.Id, Model = item.Model, Type = item.Type };
    }

    private async Task Delete(long id)
    {
        await AircraftService.DeleteAsync(id);
        await LoadAircrafts();
    }

    private void ResetForm() => aircraftForm = new AircraftDTO();
}