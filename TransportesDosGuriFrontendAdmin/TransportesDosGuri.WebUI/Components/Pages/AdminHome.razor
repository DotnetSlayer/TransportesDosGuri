        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        border: 1px solid transparent;
        box-shadow: inset 0 1px rgba(255,255,255,.06);
    }

        .stat-icon svg {
            width: 20px;
            height: 20px;
        }

    .stat-link {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-decoration: none;
        opacity: .75;
        transition: opacity .2s ease, transform .2s ease;
