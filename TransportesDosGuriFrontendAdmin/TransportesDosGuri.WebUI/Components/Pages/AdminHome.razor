                            {
                                <span class="skeleton">...</span>
                            }
                            else
                            {
                                <span>@totalUsers</span>
                            }
                        </div>
                    </div>
                </a>

            </section>

        </div>

    </main>

</div>

<style>

    .dashboard-page {
        position: relative;
        min-height: 100%;
        width: 100%;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .background-effects {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    .dashboard-main {
        position: relative;
        z-index: 1;
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }

    .dashboard-container {
        flex: 1;
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .dashboard-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .dashboard-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .dashboard-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .dashboard-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .refresh-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 0 18px;
        height: 42px;
        border-radius: 13px;
        cursor: pointer;
        color: #cbd5e1;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .02em;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 10px 25px rgba(0,0,0,.18);
        transition: all .25s ease;
    }

        .refresh-button svg {
            width: 15px;
            height: 15px;
            color: #94a3b8;
            transition: transform .4s ease, color .2s ease;
        }

        .refresh-button:hover:not(:disabled) {
            color: #ffffff;
            border-color: rgba(168,85,247,.35);
            background: linear-gradient(135deg, rgba(79,70,229,.20), rgba(147,51,234,.14));
            box-shadow: 0 12px 30px rgba(99,102,241,.22), inset 0 1px rgba(255,255,255,.08);
        }

            .refresh-button:hover:not(:disabled) svg {
                color: #c4b5fd;
                transform: rotate(180deg);
            }

        .refresh-button:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 16px;
    }

    @@media (min-width: 640px) {
        .stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1100px) {
        .stat-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }


    .stat-card {
        position: relative;
        display: block;
        padding: 22px;
        border-radius: 20px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            border-color: rgba(168,85,247,.30);
            box-shadow: inset 0 1px rgba(255,255,255,.06), 0 26px 55px rgba(99,102,241,.22);
        }

    .stat-card-glow {
        position: absolute;
        width: 200px;
        height: 200px;
        top: -110px;
        right: -110px;
        border-radius: 50%;
        filter: blur(70px);
        opacity: .5;
        pointer-events: none;
        transition: opacity .3s ease;
    }

    .stat-card:hover .stat-card-glow {
        opacity: .8;
    }

    .stat-card-indigo .stat-card-glow {
        background: rgba(99,102,241,.55);
    }

    .stat-card-purple .stat-card-glow {
        background: rgba(168,85,247,.55);
    }

    .stat-card-emerald .stat-card-glow {
        background: rgba(16,185,129,.45);
    }

    .stat-card-amber .stat-card-glow {
        background: rgba(245,158,11,.45);
    }

    .stat-card-indigo .stat-icon {
        color: #a5b4fc;
        background: rgba(99,102,241,.12);
        border-color: rgba(99,102,241,.22);
    }

    .stat-card-purple .stat-icon {
        color: #d8b4fe;
        background: rgba(168,85,247,.12);
        border-color: rgba(168,85,247,.22);
    }

    .stat-card-emerald .stat-icon {
        color: #6ee7b7;
        background: rgba(16,185,129,.12);
        border-color: rgba(16,185,129,.22);
    }

    .stat-card-amber .stat-icon {
        color: #fcd34d;
        background: rgba(245,158,11,.12);
        border-color: rgba(245,158,11,.22);
    }

    .stat-card-indigo .stat-link {
        color: #a5b4fc;
    }

    .stat-card-purple .stat-link {
        color: #d8b4fe;
    }

    .stat-card-emerald .stat-link {
        color: #6ee7b7;
    }

    .stat-card-amber .stat-link {
        color: #fcd34d;
    }

    .stat-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
