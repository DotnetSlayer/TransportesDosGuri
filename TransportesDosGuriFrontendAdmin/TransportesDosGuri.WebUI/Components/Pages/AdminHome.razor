@page "/adminHome"

@inject IAircraftService AircraftService
@inject IAirportService AirportService
@inject IAsaasIntegrationService AsaasIntegrationService
@inject IFlightSeatService FlightSeatService
@inject IFlightService FlightService
@inject IPurchaseService PurchaseService
@inject IReservationService ReservationService
@inject IScheduleService ScheduleService
@inject ISeatService SeatService
@inject ITripService TripService
@inject IUserRequestService UserRequestService
@inject IUserService UserService

@using Microsoft.AspNetCore.Authorization
@using TransportesDosGuri.Core.Interfaces

@attribute [Authorize]

<PageTitle>Transportes Dos Guri</PageTitle>

<div class="dashboard-page">

    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="dashboard-main">

        <div class="dashboard-container">

            <header class="dashboard-header">

                <div class="header-text">
                    <h1>
                        Painel de
                        <span>Administrador.</span>
                    </h1>
                    <p>
                        Métricas em tempo real da frota, voos, aeroportos e tripulação registrada.
                    </p>
                </div>

                <button type="button"
                        @onclick="LoadDashboardData"
                        disabled="@isLoading"
                        class="refresh-button">

                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>

                    <span>@(isLoading ? "Carregando..." : "Atualizar Dados")</span>

                </button>

            </header>

            <section class="stat-grid">

                <a href="/adminAircrafts" class="stat-card stat-card-indigo">
                    <div class="stat-card-glow"></div>
                    <div class="stat-top">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"
                                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <span class="stat-link">Ver Base →</span>
                    </div>
                    <div class="stat-body">
                        <div class="stat-label">Aeronaves Cadastradas</div>
                        <div class="stat-value">
                            @if (isLoading)
                            {
                                <span class="skeleton">...</span>
                            }
                            else
                            {
                                <span>@totalAircrafts</span>
                            }
                        </div>
                    </div>
                </a>

                <a href="/adminAirports" class="stat-card stat-card-emerald">
                    <div class="stat-card-glow"></div>
                    <div class="stat-top">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
