</style>

@code {
    private int totalAircrafts;
    private int totalAirports;
    private int totalAsaasIntegrations;
    private int totalFlightSeats;
    private int totalFlights;
    private int totalPurchases;
    private int totalReservations;
    private int totalSchedules;
    private int totalSeats;
    private int totalTrips;
    private int totalUserRequests;
    private int totalUsers;

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;

        try
        {
            var aircrafts = await AircraftService.GetAllAsync();
            totalAircrafts = aircrafts?.Count ?? 0;

            var airports = await AirportService.GetAllAsync();
            totalAirports = airports?.Count ?? 0;

            var asaasIntegrations = await AsaasIntegrationService.GetAllAsync();
            totalAsaasIntegrations = asaasIntegrations?.Count ?? 0;

            var flightSeats = await FlightSeatService.GetAllAsync();
            totalFlightSeats = flightSeats?.Count ?? 0;

            var flights = await FlightService.GetAllAsync();
            totalFlights = flights?.Count ?? 0;

            var purchases = await PurchaseService.GetAllAsync();
            totalPurchases = purchases?.Count ?? 0;

            var reservations = await ReservationService.GetAllAsync();
            totalReservations = reservations?.Count ?? 0;

            var schedules = await ScheduleService.GetAllAsync();
            totalSchedules = schedules?.Count ?? 0;

            var seats = await SeatService.GetAllAsync();
            totalSeats = seats?.Count ?? 0;

            var trips = await TripService.GetAllAsync();
            totalTrips = trips?.Count ?? 0;

            var userRequests = await UserRequestService.GetAllAsync();
            totalUserRequests = userRequests?.Count ?? 0;

            var users = await UserService.GetAllAsync();
            totalUsers = users?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dados do dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}