@page "/adminAsaasIntegrations"
@rendermode InteractiveServer
@attribute [Authorize]

@inject IAsaasIntegrationService AsaasIntegrationService
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces
@using Microsoft.AspNetCore.Authorization

<PageTitle>Transportes Dos Guri</PageTitle>

<div class="asaas-page">

    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="asaas-main">

        <div class="asaas-container">

            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Integrações Asaas.</span>
                    </h1>
                    <p>
                        Configure o ambiente de pagamentos da Transportes dos Guri. Chaves são armazenadas de forma segura.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(asaasIntegrations?.Count ?? 0)</span>
                    <span class="counter-label">Integrações</span>
                </div>

            </header>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                        <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <span>@errorMessage</span>
                    <button @onclick="() => errorMessage = null" class="close-btn">×</button>
                </div>
            }

            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(asaasIntegrationForm.Id == 0 ? "01" : "02")</span>
                        @(asaasIntegrationForm.Id == 0 ? "Nova integração" : "Editando integração")
                    </div>
                </div>

                <EditForm Model="asaasIntegrationForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="form-grid">

                        <div class="field">
                            <label>Ambiente</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="9"
                                                stroke="currentColor"
                                                stroke-width="1.7" />
                                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputText class="input"
                                           @bind-Value="asaasIntegrationForm.Environment"
                                           placeholder="Sandbox / Production" />
                            </div>
                        </div>

                        <div class="field">
                            <label>URL Base</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputText class="input input-mono"
                                           @bind-Value="asaasIntegrationForm.BaseUrl"
                                           placeholder="https://api.asaas.com/v3" />
                            </div>
                        </div>

                        <div class="field">
                            <label>Chave da API</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <rect x="4" y="10" width="16" height="11" rx="2"
                                              stroke="currentColor"
                                              stroke-width="1.7" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputText type="@(showApiKey ? "text" : "password")"
                                           class="input input-mono input-with-action"
                                           @bind-Value="asaasIntegrationForm.ApiKey"
                                           placeholder="Sua chave secreta" />
                                <button type="button"
                                        class="input-action"
                                        @onclick="() => showApiKey = !showApiKey"
                                        title="@(showApiKey ? "Ocultar" : "Revelar")">
                                    @if (showApiKey)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round" />
                                            <path d="M1 1l22 22"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7" />
                                            <circle cx="12" cy="12" r="3"
                                                    stroke="currentColor"
                                                    stroke-width="1.7" />
                                        </svg>
                                    }
                                </button>
                            </div>
                        </div>

                    </div>

                    <div class="form-actions-row">

                        <label class="toggle-active @(asaasIntegrationForm.IsActive ? "is-on" : "")">
                            <InputCheckbox @bind-Value="asaasIntegrationForm.IsActive" class="toggle-input" />
                            <span class="toggle-track">
                                <span class="toggle-thumb"></span>
                            </span>
                            <span class="toggle-label">
                                Ambiente ativo
                            </span>
                        </label>

                        <div class="form-actions">
                            @if (asaasIntegrationForm.Id != 0)
                            {
                                <button type="button" @onclick="ResetForm" class="btn-secondary">
                                    Cancelar
                                </button>
                            }

                            <button type="submit" class="btn-primary">
                                <span>@(asaasIntegrationForm.Id == 0 ? "Salvar" : "Atualizar")</span>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>

                    </div>

                </EditForm>

            </section>

            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Integrações configuradas
                    </div>
                </div>

                @if (asaasIntegrations == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando integrações...</span>
                    </div>
                }
                else if (!asaasIntegrations.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhuma integração configurada.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-status">Status</th>
                                    <th>Ambiente</th>
                                    <th>URL Base</th>
                                    <th class="col-key">API Key</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in asaasIntegrations)
                                {
                                    <tr>
                                        <td class="col-status">
                                            @if (item.IsActive)
                                            {
                                                <span class="status-pill status-active">
                                                    <span class="status-dot"></span>
                                                    Ativo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-inactive">
                                                    <span class="status-dot"></span>
                                                    Inativo
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <span class="environment-badge">
                                                @item.Environment
                                            </span>
                                        </td>

                                        <td>
                                            <span class="mono-value">@item.BaseUrl</span>
                                        </td>

                                        <td class="col-key">
                                            <span class="masked-value">
                                                <svg viewBox="0 0 24 24" fill="none">
                                                    <rect x="4" y="10" width="16" height="11" rx="2"
                                                          stroke="currentColor"
                                                          stroke-width="1.6" />
                                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"
                                                          stroke="currentColor"
                                                          stroke-width="1.6"
                                                          stroke-linecap="round" />
                                                </svg>
                                                ••••••••••••
                                            </span>
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    .asaas-page {
        position: relative;
        min-height: 100%;
        width: 100%;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .background-effects {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    .asaas-main {
        position: relative;
        z-index: 1;
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }

    .asaas-container {
        flex: 1;
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    .alert-error {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 14px;
        background: rgba(244, 63, 94, .10);
        border: 1px solid rgba(244, 63, 94, .30);
        color: #fda4af;
        font-size: 13px;
        font-weight: 600;
        animation: slideDown .3s ease;
    }

        .alert-error svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .alert-error .close-btn {
            margin-left: auto;
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            font-size: 20px;
            line-height: 1;
            padding: 0;
            opacity: .7;
            transition: opacity .2s;
        }

            .alert-error .close-btn:hover {
                opacity: 1;
            }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        top: -180px;
        right: -180px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 18px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    .form-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 768px) {
        .form-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
    }

    .input-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12.5px;
    }

    .input::placeholder {
        color: #475569;
    }

    .input:hover {
        border-color: rgba(148,163,184,.16);
    }

    .input:focus {
        border-color: rgba(168,85,247,.55);
        background: rgba(15,23,42,.86);
        box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
    }

    .input-with-action {
        padding-right: 46px;
    }

    .input-action {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid transparent;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        transition: all .2s ease;
    }

        .input-action svg {
            width: 15px;
            height: 15px;
        }

        .input-action:hover {
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border-color: rgba(139,92,246,.22);
        }

    .form-actions-row {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }

    @@media (min-width: 640px) {
        .form-actions-row {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .toggle-active {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        user-select: none;
    }

    .toggle-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .toggle-track {
        position: relative;
        width: 40px;
        height: 22px;
        border-radius: 999px;
        background: rgba(15,23,42,.9);
        border: 1px solid rgba(255,255,255,.08);
        transition: all .25s ease;
        flex-shrink: 0;
    }

    .toggle-thumb {
        position: absolute;
        top: 50%;
        left: 3px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #475569;
        transform: translateY(-50%);
        transition: all .25s cubic-bezier(.4,0,.2,1);
    }

    .toggle-active.is-on .toggle-track {
        background: linear-gradient(110deg, #4f46e5, #9333ea);
        border-color: rgba(168,85,247,.5);
        box-shadow: 0 0 20px rgba(139,92,246,.35);
    }

    .toggle-active.is-on .toggle-thumb {
        left: 21px;
        background: #ffffff;
        box-shadow: 0 0 10px rgba(255,255,255,.6);
    }

    .toggle-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .02em;
        color: #94a3b8;
        transition: color .2s ease;
    }

    .toggle-active.is-on .toggle-label {
        color: #e2e8f0;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        align-items: stretch;
    }

    .btn-primary {
        display: inline-flex;
