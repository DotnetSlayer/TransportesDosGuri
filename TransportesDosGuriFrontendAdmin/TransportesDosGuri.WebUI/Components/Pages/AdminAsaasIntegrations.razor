@code {
    private List<AsaasIntegrationDTO>? asaasIntegrations;
    private AsaasIntegrationDTO asaasIntegrationForm = new();
    private bool showApiKey = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsaasIntegrations();

    private async Task LoadAsaasIntegrations()
        => asaasIntegrations = await AsaasIntegrationService.GetAllAsync();

    private async Task Save()
    {
        errorMessage = null;

        if (asaasIntegrationForm.Id == 0)
            await AsaasIntegrationService.CreateAsync(asaasIntegrationForm);
        else
            await AsaasIntegrationService.UpdateAsync(asaasIntegrationForm.Id, asaasIntegrationForm);

        ResetForm();
        await LoadAsaasIntegrations();
    }

    private void Edit(AsaasIntegrationDTO item) => asaasIntegrationForm = new AsaasIntegrationDTO
    {
        Id = item.Id,
        Environment = item.Environment,
        ApiKey = item.ApiKey,
        BaseUrl = item.BaseUrl,
        IsActive = item.IsActive
    };

    private async Task Delete(long id)
    {
        errorMessage = null;

        var (success, error) = await AsaasIntegrationService.DeleteAsync(id);

        if (!success)
        {
            errorMessage = error;
            return;
        }

        await LoadAsaasIntegrations();
    }

    private void ResetForm()
    {
        asaasIntegrationForm = new AsaasIntegrationDTO();
        showApiKey = false;
    }
}