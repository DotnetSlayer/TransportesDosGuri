@page "/adminAirports"
@rendermode InteractiveServer

@inject IAirportService AirportService
@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<PageTitle>Transportes Dos Guri · Aeroportos</PageTitle>

<div class="airports-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="airports-main">

        <div class="airports-container">

            <!-- HEADER -->
            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Aeroportos.</span>
                    </h1>
                    <p>
                        Cadastre e gerencie os aeroportos conectados à malha da Transportes dos Guri.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(airports?.Count ?? 0)</span>
                    <span class="counter-label">Aeroportos</span>
                </div>

            </header>

            <!-- FORM CARD -->
            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(airportForm.Id == 0 ? "01" : "02")</span>
                        @(airportForm.Id == 0 ? "Novo aeroporto" : "Editando aeroporto")
                    </div>
                </div>

                <EditForm Model="airportForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="form-grid form-grid-4">

                        <!-- NAME -->
                        <div class="field field-full">
                            <label>Nome</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputText class="input"
                                           @bind-Value="airportForm.Name"
                                           placeholder="Ex: Aeroporto Internacional de Guarulhos" />
                            </div>
                        </div>

                        <!-- CITY -->
                        <div class="field">
                            <label>Cidade</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                        <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputText class="input"
                                           @bind-Value="airportForm.City"
                                           placeholder="Ex: São Paulo" />
                            </div>
                        </div>

                        <!-- STATE -->
                        <div class="field">
                            <label>Estado</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                        <path d="M9 3v15M15 6v15"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputText class="input input-uppercase"
                                           @bind-Value="airportForm.State"
                                           maxlength="2"
                                           placeholder="SP" />
                            </div>
                        </div>

                        <!-- COUNTRY -->
                        <div class="field">
                            <label>País</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="9"
                                                stroke="currentColor"
                                                stroke-width="1.7" />
                                        <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputText class="input"
                                           @bind-Value="airportForm.Country"
                                           placeholder="Ex: Brasil" />
                            </div>
                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="form-actions">
                        @if (airportForm.Id != 0)
                        {
                            <button type="button" @onclick="ResetForm" class="btn-secondary">
                                Cancelar
                            </button>
                        }

                        <button type="submit" class="btn-primary">
                            <span>@(airportForm.Id == 0 ? "Criar aeroporto" : "Atualizar aeroporto")</span>
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M5 12h14M13 6l6 6-6 6"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                </EditForm>

            </section>

            <!-- TABLE CARD -->
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Aeroportos cadastrados
                    </div>
                </div>

                @if (airports == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando aeroportos...</span>
                    </div>
                }
                else if (!airports.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                            <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhum aeroporto cadastrado.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th>Nome</th>
                                    <th>Cidade</th>
                                    <th class="col-state">UF</th>
                                    <th>País</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in airports)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@item.Id</span>
                                        </td>

                                        <td>
                                            <div class="airport-cell">
                                                <span class="airport-icon">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                </span>
                                                <span class="airport-name">@item.Name</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="city-value">@item.City</span>
                                        </td>

                                        <td class="col-state">
                                            <span class="state-badge">@item.State</span>
                                        </td>

                                        <td>
                                            <span class="country-value">@item.Country</span>
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */
    .airports-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* =========================================================
           BACKGROUND
        ========================================================= */
    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    /* =========================================================
           LAYOUT
        ========================================================= */
    .airports-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .airports-container {
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* =========================================================
           HEADER
        ========================================================= */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    /* =========================================================
           FORM CARD
        ========================================================= */
    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        top: -190px;
        right: -190px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    /* =========================================================
           FORM GRID
        ========================================================= */
    .form-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    @@media (min-width: 640px) {
        .form-grid-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .field-full {
            grid-column: 1 / -1;
        }
    }

    /* =========================================================
           FIELD
        ========================================================= */
    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
        appearance: none;
    }

    .input-uppercase {
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 700;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .input::placeholder {
        color: #475569;
        text-transform: none;
        letter-spacing: normal;
        font-weight: 400;
        font-family: inherit;
    }

    .input:hover {
        border-color: rgba(148,163,184,.16);
    }

    .input:focus {
        border-color: rgba(168,85,247,.55);
        background: rgba(15,23,42,.86);
        box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
    }

    /* =========================================================
           FORM ACTIONS
        ========================================================= */
    .form-actions {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 24px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient(110deg, #4f46e5, #9333ea 55%, #f59e0b);
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary svg {
            width: 15px;
            height: 15px;
            transition: transform .25s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .btn-primary:hover svg {
                transform: translateX(4px);
            }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 18px;
        border-radius: 13px;
        cursor: pointer;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        transition: all .22s ease;
    }

        .btn-secondary:hover {
            color: #cbd5e1;
            border-color: rgba(148,163,184,.25);
            background: linear-gradient(135deg, rgba(30,41,59,.76), rgba(15,23,42,.58));
        }

    /* =========================================================
           TABLE CARD
        ========================================================= */
    .table-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .table-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        bottom: -190px;
        left: -190px;
        border-radius: 50%;
        background: rgba(147,51,234,.28);
        filter: blur(90px);
        pointer-events: none;
    }

    .table-header {
        position: relative;
        z-index: 1;
        margin-bottom: 18px;
    }

    /* =========================================================
           DATA TABLE
        ========================================================= */
    .table-scroll {
        position: relative;
        z-index: 1;
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        .data-table thead th {
            text-align: left;
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: #64748b;
            border-bottom: 1px solid rgba(255,255,255,.06);
            white-space: nowrap;
        }

        .data-table tbody tr {
            transition: background .2s ease;
        }

            .data-table tbody tr:hover {
                background: rgba(255,255,255,.025);
            }

        .data-table tbody td {
            padding: 14px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            color: #cbd5e1;
            vertical-align: middle;
        }

        .data-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .col-id {
        width: 80px;
    }

    .col-state {
        width: 80px;
    }

    .col-actions {
        text-align: right;
        white-space: nowrap;
    }

    /* id chip */
    .id-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: #a5b4fc;
        background: rgba(99,102,241,.10);
        border: 1px solid rgba(99,102,241,.18);
    }

    /* airport cell */
    .airport-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .airport-icon {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #c4b5fd;
        background: rgba(139,92,246,.10);
        border: 1px solid rgba(139,92,246,.15);
    }

        .airport-icon svg {
            width: 15px;
            height: 15px;
