@code {
    private List<AirportDTO>? airports;
    private AirportDTO airportForm = new();

    protected override async Task OnInitializedAsync() => await LoadAirports();

    private async Task LoadAirports() => airports = await AirportService.GetAllAsync();

    private async Task Save()
    {
        if (airportForm.Id == 0)
            await AirportService.CreateAsync(airportForm);
        else
            await AirportService.UpdateAsync(airportForm.Id, airportForm);

        ResetForm();
        await LoadAirports();
    }

    private void Edit(AirportDTO item) => airportForm = new AirportDTO
    {
        Id = item.Id,
        Name = item.Name,
        City = item.City,
        State = item.State,
        Country = item.Country
    };

    private async Task Delete(long id)
    {
        await AirportService.DeleteAsync(id);
        await LoadAirports();
    }

    private void ResetForm() => airportForm = new AirportDTO();
}