@page "/adminSeats"
@rendermode InteractiveServer

@inject ISeatService SeatService
@inject IAircraftService AircraftService

@using TransportesDosGuri.Core.DTOs
@using TransportesDosGuri.Core.Interfaces

<PageTitle>Transportes Dos Guri · Assentos</PageTitle>

<div class="seats-page">

    <!-- BACKGROUND EFFECTS -->
    <div class="background-effects">
        <div class="orb orb-purple"></div>
        <div class="orb orb-indigo"></div>
        <div class="orb orb-amber"></div>
        <div class="grid-overlay"></div>
    </div>

    <main class="seats-main">

        <div class="seats-container">

            <!-- HEADER -->
            <header class="page-header">

                <div class="header-text">
                    <h1>
                        <span>Assentos.</span>
                    </h1>
                    <p>
                        Cadastre os assentos base de cada aeronave, com classe, localização e lado.
                    </p>
                </div>

                <div class="header-counter">
                    <span class="counter-value">@(seats?.Count ?? 0)</span>
                    <span class="counter-label">Assentos</span>
                </div>

            </header>

            <!-- FORM CARD -->
            <section class="form-card">

                <div class="form-card-glow"></div>

                <div class="form-header">
                    <div class="section-label">
                        <span>@(seatForm.Id == 0 ? "01" : "02")</span>
                        @(seatForm.Id == 0 ? "Novo assento" : "Editando assento")
                    </div>
                </div>

                <EditForm Model="seatForm" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="form-grid form-grid-5">

                        <!-- AERONAVE -->
                        <div class="field">
                            <label>Aeronave</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputSelect class="input" @bind-Value="seatForm.AircraftId">
                                    <option value="0">Selecione...</option>
                                    @foreach (var aircraft in aircraftList)
                                    {
                                        <option value="@aircraft.Id">@aircraft.Model</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <!-- SEAT NUMBER -->
                        <div class="field">
                            <label>Assento</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M6 19v2M18 19v2M6 15h12M6 15V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8M6 11h12"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputText class="input input-uppercase"
                                           @bind-Value="seatForm.SeatNumber"
                                           placeholder="Ex: 1A" />
                            </div>
                        </div>

                        <!-- CLASS -->
                        <div class="field">
                            <label>Classe</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M12 2l2.09 6.26L20 9.27l-4.91 4.02L16.18 20 12 16.77 7.82 20l1.09-6.71L4 9.27l5.91-1.01L12 2z"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                </span>
                                <InputSelect class="input" @bind-Value="seatForm.Class">
                                    @foreach (var seatClass in Enum.GetValues<SeatClass>())
                                    {
                                        <option value="@seatClass">@seatClass</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <!-- LOCATION -->
                        <div class="field">
                            <label>Localização</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="9"
                                                stroke="currentColor"
                                                stroke-width="1.7" />
                                        <path d="M12 3v18M3 12h18"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputSelect class="input" @bind-Value="seatForm.Location">
                                    @foreach (var location in Enum.GetValues<SeatLocation>())
                                    {
                                        <option value="@location">@location</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <!-- SIDE -->
                        <div class="field">
                            <label>Lado</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M9 3v18M15 3v18"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                        <path d="M3 12h18"
                                              stroke="currentColor"
                                              stroke-width="1.7"
                                              stroke-linecap="round" />
                                    </svg>
                                </span>
                                <InputSelect class="input" @bind-Value="seatForm.Side">
                                    @foreach (var side in Enum.GetValues<SeatSide>())
                                    {
                                        <option value="@side">@side</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="form-actions">
                        @if (seatForm.Id != 0)
                        {
                            <button type="button" @onclick="ResetForm" class="btn-secondary">
                                Cancelar
                            </button>
                        }

                        <button type="submit" class="btn-primary">
                            <span>@(seatForm.Id == 0 ? "Criar assento" : "Atualizar assento")</span>
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M5 12h14M13 6l6 6-6 6"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                </EditForm>

            </section>

            <!-- TABLE CARD -->
            <section class="table-card">

                <div class="table-card-glow"></div>

                <div class="table-header">
                    <div class="section-label">
                        <span>03</span>
                        Assentos cadastrados
                    </div>
                </div>

                @if (seats == null)
                {
                    <div class="state-empty">
                        <div class="spinner"></div>
                        <span>Carregando assentos...</span>
                    </div>
                }
                else if (!seats.Any())
                {
                    <div class="state-empty">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M6 19v2M18 19v2M6 15h12M6 15V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8M6 11h12"
                                  stroke="currentColor"
                                  stroke-width="1.6"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        <span>Nenhum assento registrado.</span>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="col-id">ID</th>
                                    <th>Aeronave</th>
                                    <th class="col-seat">Assento</th>
                                    <th>Classe</th>
                                    <th>Localização</th>
                                    <th>Lado</th>
                                    <th class="col-actions">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in seats)
                                {
                                    <tr>
                                        <td class="col-id">
                                            <span class="id-chip">#@item.Id</span>
                                        </td>

                                        <td>
                                            <div class="aircraft-cell">
                                                <span class="aircraft-icon">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                </span>
                                                <span class="aircraft-name">@GetAircraftModel(item.AircraftId)</span>
                                            </div>
                                        </td>

                                        <td class="col-seat">
                                            <span class="seat-badge">@item.SeatNumber</span>
                                        </td>

                                        <td>
                                            <span class="enum-chip @GetClassVariant(item.Class)">
                                                @item.Class
                                            </span>
                                        </td>

                                        <td>
                                            <span class="enum-chip @GetLocationVariant(item.Location)">
                                                @item.Location
                                            </span>
                                        </td>

                                        <td>
                                            <span class="enum-chip @GetSideVariant(item.Side)">
                                                @item.Side
                                            </span>
                                        </td>

                                        <td class="col-actions">
                                            <div class="row-actions">
                                                <button @onclick="() => Edit(item)" class="action-link">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M12 20h9"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Editar
                                                </button>
                                                <button @onclick="() => Delete(item.Id)" class="action-link action-danger">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                                                              stroke="currentColor"
                                                              stroke-width="1.8"
                                                              stroke-linecap="round"
                                                              stroke-linejoin="round" />
                                                    </svg>
                                                    Excluir
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </main>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */
    .seats-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* =========================================================
           BACKGROUND
        ========================================================= */
    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .32;
        animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(40px,-30px,0) scale(1.08);
        }
    }

    /* =========================================================
           LAYOUT
        ========================================================= */
    .seats-main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .seats-container {
        flex: 1;
        width: 100%;
        max-width: 1300px;
        margin: 0 auto;
        padding: 32px clamp(20px, 4vw, 48px) 48px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* =========================================================
           HEADER
        ========================================================= */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .page-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-text {
        max-width: 620px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.18);
        color: #a5b4fc;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
        animation: pulse 2.2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    .page-header h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(28px, 3.4vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .page-header h1 span {
            color: transparent;
            background: linear-gradient(90deg, #f472b6, #a855f7, #6366f1);
            background-clip: text;
            -webkit-background-clip: text;
        }

    .page-header p {
        margin: 13px 0 0;
        max-width: 520px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .header-counter {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(22px);
    }

    .counter-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.04em;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .counter-label {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #64748b;
    }

    /* =========================================================
           FORM CARD
        ========================================================= */
    .form-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .form-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        top: -190px;
        right: -190px;
        border-radius: 50%;
        background: rgba(99,102,241,.35);
        filter: blur(90px);
        pointer-events: none;
    }

    .form-header {
        position: relative;
        z-index: 1;
        margin-bottom: 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 10px;
            font-weight: 800;
        }

    /* =========================================================
           FORM GRID
        ========================================================= */
    .form-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    @@media (min-width: 640px) {
        .form-grid-5 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1024px) {
        .form-grid-5 {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* =========================================================
           FIELD
        ========================================================= */
    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 16px;
        height: 16px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .input {
        width: 100%;
        height: 48px;
        padding: 0 16px 0 44px;
        border-radius: 13px;
        outline: none;
        border: 1px solid rgba(255,255,255,.07);
        color: #f1f5f9;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
        font-size: 13px;
        font-family: inherit;
        transition: all .25s ease;
        appearance: none;
    }

    .input-uppercase {
        text-transform: uppercase;
        letter-spacing: .1em;
        font-weight: 700;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .input::placeholder {
        color: #475569;
        text-transform: none;
        letter-spacing: normal;
        font-weight: 400;
        font-family: inherit;
    }

    .input:hover {
        border-color: rgba(148,163,184,.16);
    }

    .input:focus {
        border-color: rgba(168,85,247,.55);
        background: rgba(15,23,42,.86);
        box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
    }

    select.input {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 16px;
        padding-right: 42px;
    }

        select.input option {
            background: #0f172a;
            color: #e2e8f0;
        }

    /* =========================================================
           FORM ACTIONS
        ========================================================= */
    .form-actions {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 24px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient(110deg, #4f46e5, #9333ea 55%, #f59e0b);
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary svg {
            width: 15px;
            height: 15px;
            transition: transform .25s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .btn-primary:hover svg {
                transform: translateX(4px);
            }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 18px;
        border-radius: 13px;
        cursor: pointer;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        background: linear-gradient(135deg, rgba(15,23,42,.76), rgba(2,6,23,.58));
        border: 1px solid rgba(255,255,255,.07);
        transition: all .22s ease;
    }

        .btn-secondary:hover {
            color: #cbd5e1;
            border-color: rgba(148,163,184,.25);
            background: linear-gradient(135deg, rgba(30,41,59,.76), rgba(15,23,42,.58));
        }

    /* =========================================================
           TABLE CARD
        ========================================================= */
    .table-card {
        position: relative;
        padding: 24px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.72), rgba(2,6,23,.55));
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 40px rgba(0,0,0,.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }

    .table-card-glow {
        position: absolute;
        width: 340px;
        height: 340px;
        bottom: -190px;
        left: -190px;
        border-radius: 50%;
        background: rgba(147,51,234,.28);
        filter: blur(90px);
        pointer-events: none;
    }

    .table-header {
        position: relative;
        z-index: 1;
        margin-bottom: 18px;
    }

    /* =========================================================
           DATA TABLE
        ========================================================= */
    .table-scroll {
        position: relative;
        z-index: 1;
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        .data-table thead th {
            text-align: left;
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: #64748b;
            border-bottom: 1px solid rgba(255,255,255,.06);
            white-space: nowrap;
        }

        .data-table tbody tr {
            transition: background .2s ease;
        }

