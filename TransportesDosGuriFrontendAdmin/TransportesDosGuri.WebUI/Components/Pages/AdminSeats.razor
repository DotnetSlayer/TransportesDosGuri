@code {
    private List<SeatDTO>? seats;
    private List<AircraftDTO> aircraftList = new();
    private SeatDTO seatForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAircrafts();
        await LoadSeats();
    }

    private async Task LoadAircrafts() => aircraftList = await AircraftService.GetAllAsync() ?? new();
    private async Task LoadSeats() => seats = await SeatService.GetAllAsync();

    private async Task Save()
    {
        if (seatForm.Id == 0)
            await SeatService.CreateAsync(seatForm);
        else
            await SeatService.UpdateAsync(seatForm.Id, seatForm);

        ResetForm();
        await LoadSeats();
    }

    private void Edit(SeatDTO item)
    {
        seatForm = new SeatDTO
        {
            Id = item.Id,
            AircraftId = item.AircraftId,
            SeatNumber = item.SeatNumber,
            Class = item.Class,
            Location = item.Location,
            Side = item.Side
        };
    }

    private async Task Delete(long id)
    {
        await SeatService.DeleteAsync(id);
        await LoadSeats();
    }

    private void ResetForm() => seatForm = new SeatDTO();

    private string GetAircraftModel(long id) =>
        aircraftList.FirstOrDefault(a => a.Id == id)?.Model ?? id.ToString();

    /* =========================================================
       VARIANT HELPERS
    ========================================================= */
    private string GetClassVariant(SeatClass seatClass) => seatClass.ToString().ToLowerInvariant() switch
    {
        "economy" => "class-economy",
        "business" => "class-business",
        "first" => "class-first",
        _ => "class-default"
    };

    private string GetLocationVariant(SeatLocation location) => location.ToString().ToLowerInvariant() switch
    {
        "window" => "location-window",
        "middle" => "location-middle",
        "aisle" => "location-aisle",
        _ => "location-middle"
    };

    private string GetSideVariant(SeatSide side) => side.ToString().ToLowerInvariant() switch
    {
        "left" => "side-left",
        "right" => "side-right",
        _ => "side-default"
    };
}