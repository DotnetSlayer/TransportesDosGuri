@code {


    private List<FlightSeatDTO>? seats;

    private List<AircraftDTO> aircraftList = new();

    private List<FlightDTO> flightList = new();

    private FlightSeatDTO seatForm = new();

    private string? errorMessage;



    protected override async Task OnInitializedAsync()
    {
        await LoadFlights();

        await LoadAircrafts();

        await LoadSeats();
    }


    private async Task LoadFlights()
    {
        flightList =
            (await FlightService.GetAllAsync())?.ToList()
            ?? new();
    }



    private async Task LoadAircrafts()
    {
        aircraftList =
            (await AircraftService.GetAllAsync())?.ToList()
            ?? new();
    }


    private async Task LoadSeats()
    {
        seats =
            (await FlightSeatService.GetAllAsync())?.ToList();
    }


    private async Task Save()
    {
        errorMessage = null;

        if (seatForm.FlightId <= 0)
        {
            errorMessage = "Selecione um voo válido.";
            return;
        }

        if (seatForm.AircraftId <= 0)
        {
            errorMessage = "Selecione uma aeronave válida.";
            return;
        }

        if (string.IsNullOrWhiteSpace(seatForm.SeatNumber))
        {
            errorMessage = "Informe o número do assento.";
            return;
        }

        try
        {
            if (seatForm.Id == 0)
            {
                await FlightSeatService.CreateAsync(seatForm);
            }
            else
            {
                await FlightSeatService.UpdateAsync(
                    seatForm.Id,
                    seatForm
                );
            }

            ResetForm();

            await LoadSeats();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao salvar assento: {ex.Message}";
        }
    }


    private void Edit(FlightSeatDTO item)
    {
        seatForm = new FlightSeatDTO
        {
            Id = item.Id,

            FlightId = item.FlightId,

            AircraftId = item.AircraftId,

            SeatNumber = item.SeatNumber,

            Class = item.Class,

            Location = item.Location,

            Side = item.Side,

            Status = item.Status
        };
    }



    private async Task Delete(long id)
    {
        errorMessage = null;

        var (success, error) = await FlightSeatService.DeleteAsync(id);

        if (!success)
        {
            errorMessage = error;
            return;
        }

        await LoadSeats();
    }



    private void ResetForm()
    {
        seatForm = new FlightSeatDTO();
    }



    private string GetFlightDescription(FlightDTO flight)
    {
        return
            $"Voo #{flight.Id} · " +
            $"{flight.DepartureTime:dd/MM/yyyy HH:mm}";
    }


    private string GetFlightDescriptionById(long flightId)
    {
        var flight =
            flightList.FirstOrDefault(
                f => f.Id == flightId
            );

        if (flight == null)
        {
            return $"Voo #{flightId}";
        }

        return GetFlightDescription(flight);
    }



    private string GetAircraftModel(long aircraftId)
    {
        return
            aircraftList
                .FirstOrDefault(
                    a => a.Id == aircraftId
                )?
                .Model
            ?? aircraftId.ToString();
    }



    private string GetClassVariant(
        SeatClass seatClass)
    {
        return seatClass
            .ToString()
            .ToLowerInvariant()
            switch
            {
                "economy" =>
                    "class-economy",

                "business" =>
                    "class-business",

                "first" =>
                    "class-first",

                _ =>
                    "class-default"
            };
    }



    private string GetLocationVariant(
        SeatLocation location)
    {
        return location
            .ToString()
            .ToLowerInvariant()
            switch
            {
                "window" =>
                    "location-window",

                "middle" =>
                    "location-middle",

                "aisle" =>
                    "location-aisle",

                _ =>
                    "location-middle"
            };
    }


    private string GetSideVariant(
        SeatSide side)
    {
        return side
            .ToString()
            .ToLowerInvariant()
            switch
            {
                "left" =>
                    "side-left",

                "right" =>
                    "side-right",

                _ =>
                    "side-default"
            };
    }



    private string GetStatusVariant(
        FlightSeatStatus status)
    {
        return status
            .ToString()
            .ToLowerInvariant()
            switch
            {
                "available" =>
                    "status-available",

                "occupied" =>
                    "status-occupied",

                "reserved" =>
                    "status-reserved",

                "blocked" =>
                    "status-blocked",

                _ =>
                    "status-default"
            };
    }

}