<style>


    * {
        box-sizing: border-box;
    }

    .auth-page {
        min-height: 100vh;
        width: 100%;
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, .13), transparent 30%), radial-gradient(circle at 85% 80%, rgba(168, 85, 247, .12), transparent 30%), #03050b;
        color: #e2e8f0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }


    .background-effects {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(100px);
        opacity: .35;
        animation: floatOrb 12s ease-in-out infinite alternate;
    }

    .orb-purple {
        width: 420px;
        height: 420px;
        background: #9333ea;
        left: -180px;
        top: -140px;
    }

    .orb-indigo {
        width: 500px;
        height: 500px;
        background: #4f46e5;
        right: -220px;
        bottom: -200px;
        animation-delay: -4s;
    }

    .orb-amber {
        width: 280px;
        height: 280px;
        background: #f59e0b;
        left: 45%;
        bottom: -180px;
        opacity: .12;
        animation-delay: -7s;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        opacity: .035;
        background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    @@keyframes floatOrb {
        from {
            transform: translate3d(0, 0, 0) scale(1);
        }

        to {
            transform: translate3d(40px, -30px, 0) scale(1.08);
        }
    }


    .auth-shell {
        min-height: 100vh;
        width: 100%;
        display: flex;
        position: relative;
        z-index: 1;
    }


    .auth-panel {
        width: 50%;
        min-height: 100vh;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 42px clamp(32px, 6vw, 96px);
        background: rgba(4, 7, 15, .72);
        border-right: 1px solid rgba(255,255,255,.07);
        backdrop-filter: blur(35px);
        -webkit-backdrop-filter: blur(35px);
        overflow: hidden;
    }

    .panel-glow {
        position: absolute;
        width: 500px;
        height: 500px;
        top: -300px;
        left: -250px;
        border-radius: 50%;
        background: rgba(139, 92, 246, .10);
        filter: blur(80px);
        pointer-events: none;
    }

    .content-wrapper {
        width: 100%;
        max-width: 510px;
        margin: auto;
        position: relative;
        z-index: 2;
    }


    .logo-container {
        display: flex;
        justify-content: center;
        margin-bottom: 34px;
    }

    .logo-glass {
        padding: 18px 26px;
        border-radius: 24px;
        background: linear-gradient( 135deg, rgba(255,255,255,.08), rgba(255,255,255,.025) );
        border: 1px solid rgba(255,255,255,.10);
        box-shadow: 0 25px 60px rgba(0,0,0,.30), inset 0 1px rgba(255,255,255,.08);
        backdrop-filter: blur(20px);
    }

    .logo {
        width: 230px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
        filter: brightness(0) invert(1) drop-shadow(0 0 25px rgba(255,255,255,.16));
    }


    .mode-switch {
        display: flex;
        gap: 5px;
        padding: 5px;
        margin-bottom: 38px;
        border-radius: 18px;
        background: rgba(2,6,23,.68);
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: inset 0 1px rgba(255,255,255,.04), 0 15px 40px rgba(0,0,0,.18);
        backdrop-filter: blur(20px);
    }

    .mode-button {
        flex: 1;
        height: 46px;
        border: 0;
        border-radius: 13px;
        background: transparent;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all .3s ease;
    }

        .mode-button:hover {
            color: #cbd5e1;
            background: rgba(255,255,255,.035);
        }

        .mode-button.active {
            color: white;
            background: linear-gradient( 135deg, rgba(79,70,229,.95), rgba(147,51,234,.95) );
            box-shadow: 0 8px 25px rgba(99,102,241,.25), inset 0 1px rgba(255,255,255,.15);
        }

        .mode-button.register-active {
            background: linear-gradient( 135deg, rgba(79,70,229,.95), rgba(147,51,234,.95), rgba(245,158,11,.80) );
        }

    .mode-icon {
        width: 17px;
        height: 17px;
        display: flex;
    }

        .mode-icon svg {
            width: 100%;
            height: 100%;
        }


    .form-header {
        text-align: left;
        margin-bottom: 30px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        margin-bottom: 14px;
        border-radius: 999px;
        background: rgba(99,102,241,.08);
        border: 1px solid rgba(99,102,241,.15);
        color: #a5b4fc;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .register-eyebrow {
        color: #c4b5fd;
    }

    .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #818cf8;
        box-shadow: 0 0 12px #818cf8;
    }

    .form-header h1 {
        margin: 0;
        color: white;
        font-size: clamp(30px, 3vw, 42px);
        line-height: 1.05;
        letter-spacing: -.045em;
        font-weight: 800;
    }

        .form-header h1 span {
            color: transparent;
            background: linear-gradient( 90deg, #f472b6, #a855f7, #6366f1 );
            background-clip: text;
            -webkit-background-clip: text;
        }

    .form-header p {
        max-width: 420px;
        margin: 13px 0 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.7;
    }


    .alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        margin-bottom: 22px;
        border-radius: 15px;
        font-size: 11px;
        backdrop-filter: blur(20px);
    }

    .alert-error {
        color: #fda4af;
        background: rgba(244,63,94,.07);
        border: 1px solid rgba(244,63,94,.16);
    }

    .alert-success {
        color: #86efac;
        background: rgba(34,197,94,.07);
        border: 1px solid rgba(34,197,94,.16);
    }

    .alert-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

        .alert-icon svg {
            width: 100%;
            height: 100%;
        }


    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .field label {
            color: #94a3b8;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .03em;
        }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper input {
            width: 100%;
            height: 52px;
            padding: 0 16px;
            border-radius: 15px;
            outline: none;
            border: 1px solid rgba(255,255,255,.07);
            color: #f1f5f9;
            background: linear-gradient( 135deg, rgba(15,23,42,.76), rgba(2,6,23,.58) );
            box-shadow: inset 0 1px rgba(255,255,255,.035), 0 8px 25px rgba(0,0,0,.10);
            font-size: 12px;
            transition: all .25s ease;
        }

            .input-wrapper input::placeholder {
                color: #475569;
            }

            .input-wrapper input:hover {
                border-color: rgba(148,163,184,.16);
            }

            .input-wrapper input:focus {
                border-color: rgba(168,85,247,.55);
                background: rgba(15,23,42,.86);
                box-shadow: 0 0 0 4px rgba(168,85,247,.07), 0 10px 35px rgba(0,0,0,.18);
            }

    .input-icon + input {
        padding-left: 46px;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        width: 17px;
        height: 17px;
        transform: translateY(-50%);
        color: #475569;
        pointer-events: none;
        z-index: 1;
    }

        .input-icon svg {
            width: 100%;
            height: 100%;
        }

    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: -3px;
    }

    .remember {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 12px;
        cursor: pointer;
    }

        .remember input {
            display: none;
        }

        .remember span {
            width: 15px;
            height: 15px;
            border-radius: 5px;
            border: 1px solid #334155;
            background: rgba(15,23,42,.7);
            transition: all .2s;
        }

        .remember input:checked + span {
            background: #7c3aed;
            border-color: #8b5cf6;
            box-shadow: 0 0 15px rgba(139,92,246,.3);
        }

    .forgot {
        color: #8b5cf6;
        font-size: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s;
    }

        .forgot:hover {
            color: #c4b5fd;
        }


    .primary-button {
        width: 100%;
        height: 54px;
        margin-top: 3px;
        border: 0;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .02em;
        background: linear-gradient( 110deg, #4f46e5, #9333ea 55%, #f59e0b );
        box-shadow: 0 15px 40px rgba(124,58,237,.22), inset 0 1px rgba(255,255,255,.18);
        transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
        text-decoration: none;
    }

        .primary-button svg {
            width: 17px;
            height: 17px;
            transition: transform .25s ease;
        }

        .primary-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(124,58,237,.32), inset 0 1px rgba(255,255,255,.20);
        }

            .primary-button:hover svg {
                transform: translateX(4px);
            }

        .primary-button:active {
            transform: translateY(0);
        }

        .primary-button:disabled {
            cursor: not-allowed;
            opacity: .55;
            transform: none;
        }


    .register-form {
        gap: 17px;
    }

    .fields-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

        .fields-grid .full {
            grid-column: 1 / -1;
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 3px;
        margin-bottom: 1px;
        color: #64748b;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

        .section-label span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #c4b5fd;
            background: rgba(139,92,246,.10);
            border: 1px solid rgba(139,92,246,.15);
            font-size: 15px;
        }

    .address-label {
        margin-top: 7px;
    }

    .register-button {
        margin-top: 5px;
        margin-bottom: 30px;
    }

    .spinner {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: white;
        animation: spin .7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }


    .footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #334155;
        font-size: 15px;
        letter-spacing: .04em;
        position: relative;
        z-index: 2;
    }

    .footer-separator {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #475569;
    }

    .footer button {
        border: 0;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        font: inherit;
        transition: color .2s;
    }

        .footer button:hover {
            color: #c4b5fd;
        }

    .footer strong {
        color: #a78bfa;
    }


    .visual-panel {
        width: 50%;
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: #05070e;
    }

    .visual-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transform: scale(1.02);
        filter: saturate(.8) contrast(1.05);
    }

    .visual-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 90deg, #03050b 0%, rgba(3,5,11,.62) 17%, rgba(3,5,11,.08) 60%, rgba(3,5,11,.20) 100% );
    }

    .visual-top-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient( 180deg, rgba(3,5,11,.75) 0%, transparent 35%, rgba(3,5,11,.78) 100% );
    }

    .visual-content {
        position: absolute;
        left: clamp(40px, 6vw, 90px);
        right: 50px;
        bottom: 100px;
        max-width: 540px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(15,23,42,.35);
        border: 1px solid rgba(255,255,255,.10);
        color: #cbd5e1;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        backdrop-filter: blur(20px);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 15px #4ade80;
    }

    .visual-content h2 {
        margin: 22px 0 14px;
        color: white;
        font-size: clamp(38px, 4vw, 64px);
        line-height: .98;
        letter-spacing: -.055em;
        font-weight: 850;
    }

        .visual-content h2 span {
            display: block;
            color: transparent;
            background: linear-gradient( 90deg, #f0abfc, #a78bfa, #818cf8 );
            background-clip: text;
            -webkit-background-clip: text;
        }

    .visual-content > p {
        max-width: 430px;
        margin: 0;
        color: #cbd5e1;
        font-size: 12px;
        line-height: 1.8;
        text-shadow: 0 2px 15px rgba(0,0,0,.5);
    }

    .feature-cards {
        display: flex;
        gap: 10px;
        margin-top: 30px;
    }

    .feature-card {
        min-width: 145px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 17px;
        background: rgba(15,23,42,.25);
        border: 1px solid rgba(255,255,255,.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: inset 0 1px rgba(255,255,255,.07), 0 15px 35px rgba(0,0,0,.18);
    }

    .feature-icon {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: #c4b5fd;
        background: rgba(139,92,246,.12);
        border: 1px solid rgba(139,92,246,.18);
    }

        .feature-icon svg {
            width: 16px;
            height: 16px;
        }

    .feature-card strong,
    .feature-card span {
        display: block;
    }

    .feature-card strong {
        color: #f8fafc;
        font-size: 9px;
        font-weight: 800;
    }

    .feature-card span {
        margin-top: 3px;
        color: #64748b;
        font-size: 8px;
    }

    .visual-footer {
        position: absolute;
        left: 45px;
        right: 45px;
        bottom: 30px;
        display: flex;
        justify-content: space-between;
        color: rgba(255,255,255,.30);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .2em;
    }


    .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
