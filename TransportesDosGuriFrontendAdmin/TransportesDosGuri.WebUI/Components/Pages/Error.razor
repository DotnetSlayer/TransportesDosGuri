@page "/error"
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Transportes Dos Guri</PageTitle>

<div class="min-h-screen w-full flex bg-[#060810] text-slate-200 antialiased font-sans selection:bg-purple-500/30 selection:text-white overflow-hidden">

    <div class="w-full lg:w-1/2 flex flex-col justify-between p-8 sm:p-12 xl:p-16 relative z-10 bg-[#060810]/95 backdrop-blur-md">

        <div class="my-auto max-w-md w-full mx-auto py-8 text-center">

            <div class="flex justify-center mb-10">
                <img src="/images/logo.png"
                     alt="Transportes dos Guri"
                     class="w-64 sm:w-72 lg:w-80 h-auto object-contain brightness-0 invert drop-shadow-[0_0_25px_rgba(255,255,255,0.15)]" />
            </div>



            <h2 class="mt-3 text-xl sm:text-2xl font-semibold text-slate-100">
                Ops! Rota fora de alcance
            </h2>

            <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm mx-auto">
                A página ou conteúdo que você tentou acessar não existe, foi movido ou você não possui permissão de acesso.
            </p>

            <div class="mt-8">
                <a href="/"
                   class="primary-button">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    VOLTAR PARA O INÍCIO
                </a>
            </div>

        </div>

        <footer class="footer">

            <span>
                © @DateTime.Now.Year · Transportes dos Guri
            </span>

            <span class="footer-separator"></span>

            <button type="button"
                    @onclick="OpenTeamModal">
                Desenvolvido pelos
                <strong>Guris</strong>
            </button>

        </footer>

    </div>

    <div class="hidden lg:block lg:w-1/2 relative">

        <img src="/images/plane.png"
             alt="Aeronave em voo"
             class="absolute inset-0 w-full h-full object-cover object-center" />

        <div class="absolute inset-0 bg-gradient-to-r from-[#060810] via-[#060810]/40 to-transparent"></div>

        <div class="absolute inset-0 bg-gradient-to-t from-[#060810] via-transparent to-transparent"></div>

    </div>

</div>

